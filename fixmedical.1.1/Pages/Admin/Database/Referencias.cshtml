@page
@model fixmedical._1._1.Pages.Admin.Database.ReferenciasModel
@{
    Layout = null;
    ViewData["Title"] = "Referencias - FixMedical";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Referencias - FixMedical</title>
    <link rel="icon" type="image/png" sizes="40x40" href="~/images/LOGO FIX CORTO_sin_fondo (1).png" />
    <link rel="apple-touch-icon" href="~/images/LOGO FIX CORTO_sin_fondo (1).png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root { --bg-0:#05070f;--bg-1:#0a1226;--bg-2:#0d1b3a;--azul:#004b87;--azul-2:#002d54;--naranja:#f39200;--neon-cyan:#22d3ee;--neon-magenta:#ff4d8d;--ok:#34d399;--bad:#ff5a6e;--txt:#eaf2ff;--txt-soft:#8fb3d9;--glass:rgba(13,20,40,.55);--glass-border:rgba(255,255,255,.08); }
        * { box-sizing:border-box; } html,body { height:100%; } body { margin:0;background-color:var(--bg-0);color:var(--txt);font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;overflow-x:hidden; }
        .bg { position:fixed;inset:0;z-index:0;overflow:hidden; } .bg-gradient { position:absolute;inset:0;background:linear-gradient(135deg,var(--bg-0) 0%,var(--bg-1) 45%,var(--bg-2) 100%);background-size:200% 200%;animation:gradientShift 18s ease infinite; }
        .blob { position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;mix-blend-mode:screen;will-change:transform; } .b1 { width:520px;height:520px;background:radial-gradient(circle at 30% 30%,var(--naranja),transparent 60%);top:-120px;left:-100px;animation:float1 22s ease-in-out infinite; } .b2 { width:620px;height:620px;background:radial-gradient(circle at 70% 40%,var(--azul),transparent 60%);bottom:-180px;right:-140px;animation:float2 26s ease-in-out infinite; } .b3 { width:420px;height:420px;background:radial-gradient(circle at 50% 50%,var(--neon-cyan),transparent 60%);top:38%;left:55%;opacity:.25;animation:float3 30s ease-in-out infinite; }
        .grid-overlay { position:absolute;inset:0;background-image:linear-gradient(rgba(34,211,238,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.06) 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 30%,#000 0%,transparent 80%);mask-image:radial-gradient(ellipse 80% 70% at 50% 30%,#000 0%,transparent 80%); }
        #particles { position:fixed;inset:0;z-index:1;pointer-events:none; }
        .navbar-neon { position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:16px 28px;background:rgba(5,7,15,.55);-webkit-backdrop-filter:blur(14px) saturate(140%);backdrop-filter:blur(14px) saturate(140%);border-bottom:1px solid var(--glass-border);box-shadow:0 6px 24px rgba(0,0,0,.4); }
        .brand { display:inline-flex;align-items:center;text-decoration:none; } .brand-logo { height:55px;width:auto;display:block;filter:drop-shadow(0 0 8px rgba(243,146,0,.55)) drop-shadow(0 0 18px rgba(243,146,0,.28));transition:filter .25s,transform .25s; } .brand:hover .brand-logo { filter:drop-shadow(0 0 12px rgba(243,146,0,.85)) drop-shadow(0 0 26px rgba(34,211,238,.35));transform:scale(1.04); }
        .nav-right { display:flex;align-items:center;gap:12px;flex-wrap:wrap; }
        .btn-glass { background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);color:var(--txt);border-radius:8px;padding:7px 16px;font-size:.85rem;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:border-color .25s,box-shadow .25s,color .25s; }
        .btn-glass:hover { border-color:var(--naranja);box-shadow:0 0 16px rgba(243,146,0,.35);color:#fff; }
        .btn-glass.bad { border-color:rgba(255,90,110,.4);color:#ffb3bc; } .btn-glass.bad:hover { border-color:var(--bad);box-shadow:0 0 16px rgba(255,90,110,.35);color:#fff; }
        .container-neon { position:relative;z-index:2;max-width:1280px;margin:0 auto;padding:34px 24px 60px; }
        .page-head { position:relative;overflow:hidden;background:var(--glass);-webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%);border:1px solid var(--glass-border);border-radius:20px;padding:22px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;box-shadow:0 20px 60px rgba(0,0,0,.45);animation:cardIn .7s cubic-bezier(.2,.8,.2,1) both; }
        .page-head::before { content:"";position:absolute;top:0;left:10%;right:10%;height:2px;background:linear-gradient(90deg,transparent,var(--naranja),var(--neon-cyan),transparent);filter:blur(1px);opacity:.85; }
        .page-head h1 { margin:0 0 4px;font-size:1.6rem;font-weight:800;text-shadow:0 0 22px rgba(34,211,238,.25); } .page-head p { margin:0;color:var(--txt-soft);font-size:.9rem; } .head-icon { font-size:2.6rem;color:var(--neon-cyan);opacity:.4;text-shadow:0 0 24px rgba(34,211,238,.5); }
        .ok-alert { display:flex;align-items:center;gap:10px;background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.4);color:#c9f7e4;border-radius:14px;padding:12px 18px;margin-bottom:20px;font-weight:600;box-shadow:0 0 24px rgba(52,211,153,.15);animation:cardIn .5s both; } .ok-alert i { color:var(--ok);text-shadow:0 0 12px rgba(52,211,153,.6); }
        .bad-alert { display:flex;align-items:center;gap:10px;background:rgba(255,90,110,.1);border:1px solid rgba(255,90,110,.45);color:#ffd7dc;border-radius:14px;padding:12px 18px;margin-bottom:20px;font-weight:600;animation:cardIn .5s both; } .bad-alert i { color:var(--bad); }
        .validation-summary-errors { background:rgba(255,90,110,.1);border:1px solid rgba(255,90,110,.45);color:#ffd7dc;border-radius:14px;padding:12px 18px;margin-bottom:20px; } .validation-summary-errors ul { margin:6px 0 0;padding-left:20px; }
        .panel-glass { background:var(--glass);-webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%);border:1px solid var(--glass-border);border-radius:20px;padding:26px 28px;box-shadow:0 16px 44px rgba(0,0,0,.4);margin-bottom:26px;animation:cardIn .9s cubic-bezier(.2,.8,.2,1) both; }
        .panel-head { display:flex;align-items:center;gap:10px;margin-bottom:20px; } .panel-head h4 { margin:0;font-weight:800;color:#fff; } .panel-head i { color:var(--neon-cyan);text-shadow:0 0 14px rgba(34,211,238,.5);font-size:1.3rem; }
        .edit-chip { margin-left:auto;font-size:.7rem;font-weight:800;letter-spacing:.8px;color:var(--naranja);border:1px solid rgba(243,146,0,.45);background:rgba(243,146,0,.1);border-radius:999px;padding:4px 12px; }
        .form-grid { display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px; } .span-2 { grid-column:span 2; }
        .field { display:flex;flex-direction:column;gap:7px;min-width:0; } .field label { font-size:.72rem;letter-spacing:.5px;color:var(--txt-soft);font-weight:700;text-transform:uppercase;display:flex;align-items:center;gap:6px;flex-wrap:wrap; } .field label .req { color:var(--bad);text-shadow:0 0 8px rgba(255,90,110,.5); }
        .neon-input { width:100%;background:rgba(5,7,15,.6);border:1px solid rgba(143,179,217,.22);color:var(--txt);border-radius:10px;padding:11px 13px;font-size:.9rem;outline:none;transition:border-color .2s,box-shadow .2s,background .2s; } .neon-input::placeholder { color:rgba(143,179,217,.4); } .neon-input:focus { border-color:var(--neon-cyan);box-shadow:0 0 0 3px rgba(34,211,238,.12),0 0 18px rgba(34,211,238,.18);background:rgba(5,7,15,.85); } input[type="date"].neon-input { color-scheme:dark; }
        .form-actions { display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:24px; }
        .neon-btn { display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 26px;border:1px solid rgba(243,146,0,.35);border-radius:10px;font-size:14px;font-weight:700;letter-spacing:.5px;color:#fff;cursor:pointer;text-decoration:none;background:linear-gradient(135deg,var(--azul) 0%,var(--azul-2) 100%);box-shadow:0 8px 24px rgba(0,75,135,.45),0 0 0 1px rgba(34,211,238,.12) inset;transition:transform .18s,box-shadow .25s,filter .25s;position:relative;overflow:hidden; }
        .neon-btn:hover { transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,75,135,.6),0 0 24px rgba(243,146,0,.5);filter:brightness(1.08);color:#fff; }
        .neon-btn.ghost { background:rgba(255,255,255,.04);border-color:rgba(143,179,217,.3);color:var(--txt-soft);box-shadow:none; } .neon-btn.ghost:hover { border-color:var(--neon-cyan);color:#fff;box-shadow:0 0 18px rgba(34,211,238,.25); }
        .neon-btn.ok { background:linear-gradient(135deg,rgba(52,211,153,.85) 0%,rgba(5,150,105,.9) 100%);border-color:rgba(52,211,153,.5);box-shadow:0 8px 24px rgba(5,150,105,.4); } .neon-btn.ok:hover { box-shadow:0 12px 30px rgba(5,150,105,.55),0 0 24px rgba(52,211,153,.5); }
        .search-row { display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px; } .search-row .neon-input { max-width:360px; }
        .table-wrap { overflow-x:auto; } .neon-table { width:100%;border-collapse:collapse;font-size:14px;min-width:900px; } .neon-table thead th { color:var(--neon-cyan);text-transform:uppercase;font-size:11px;letter-spacing:.7px;padding:12px 14px;border-bottom:1px solid rgba(34,211,238,.25);text-align:left;white-space:nowrap; } .neon-table tbody td { padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.06);color:var(--txt); } .neon-table tbody tr { transition:background .2s; } .neon-table tbody tr:hover { background:rgba(34,211,238,.05); }
        .td-code { font-weight:700;color:#fff;text-shadow:0 0 10px rgba(34,211,238,.25);white-space:nowrap; } .td-soft { color:var(--txt-soft); }
        .td-actions { white-space:nowrap; } .td-actions form { display:inline-block;margin:0; } .td-actions .btn-glass { padding:5px 12px;font-size:.78rem; }
        .empty-state { color:var(--txt-soft);display:flex;align-items:center;gap:8px;padding:6px 2px; }
        @@keyframes gradientShift { 0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%} } @@keyframes float1 { 0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(60px,50px) scale(1.12)} } @@keyframes float2 { 0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-70px,-40px) scale(1.10)} } @@keyframes float3 { 0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-50px,40px) scale(1.15)} } @@keyframes cardIn { from{opacity:0;transform:translateY(26px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)} }
        @@media (prefers-reduced-motion: reduce) { .blob,.bg-gradient,.page-head,.panel-glass,.ok-alert,.bad-alert { animation:none !important; } }
        @@media (max-width:1200px) { .form-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
        @@media (max-width:900px) { .form-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .span-2 { grid-column:span 2; } .container-neon { padding:24px 16px 48px; } }
        @@media (max-width:560px) { .form-grid { grid-template-columns:1fr; } .span-2 { grid-column:span 1; } .page-head { flex-direction:column;align-items:flex-start; } .head-icon { display:none; } .form-actions { flex-direction:column; } .form-actions .neon-btn { width:100%; } .navbar-neon { padding:12px 16px; } }
    </style>
</head>
<body>

    <div class="bg" aria-hidden="true">
        <div class="bg-gradient"></div>
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="blob b3"></div>
        <div class="grid-overlay"></div>
    </div>
    <canvas id="particles" aria-hidden="true"></canvas>

    <nav class="navbar-neon">
        <a href="/Admin/Database" class="brand" title="FixMedical">
            <img src="~/images/LOGO FIX CORTO_sin_fondo (1).png" alt="FixMedical" class="brand-logo" />
        </a>
        <div class="nav-right">
            <a href="/HojasGasto/Crear" class="btn-glass"><i class="bi bi-file-earmark-medical"></i> Hoja de Gasto</a>
            <a href="/TarjetasImplante/Crear" class="btn-glass"><i class="bi bi-card-checklist"></i> Tarjeta de Implante</a>
            <a href="/Admin/Database/Registros" class="btn-glass"><i class="bi bi-table"></i> Consultar Tabla</a>
            <a href="/Admin/Database" class="btn-glass"><i class="bi bi-arrow-left"></i> Volver</a>
        </div>
    </nav>

    <div class="container-neon">

        <section class="page-head">
            <div>
                <h1>Referencias</h1>
                <p>Creación, consulta y edición del catálogo de Productos.</p>
            </div>
            <i class="bi bi-upc-scan head-icon"></i>
        </section>

        @{ var okMsg = TempData["OkMessage"] as string; }
        @if (!string.IsNullOrEmpty(okMsg))
        {
            <div class="ok-alert"><i class="bi bi-check-circle-fill"></i> @okMsg</div>
        }
        @{ var errMsg = TempData["ErrorMessage"] as string; }
        @if (!string.IsNullOrEmpty(errMsg))
        {
            <div class="bad-alert"><i class="bi bi-x-octagon-fill"></i> @errMsg</div>
        }

        <div asp-validation-summary="All"></div>

        <form method="post" id="formRef">
            <input type="hidden" asp-for="CodigoOriginal" />
            <input type="hidden" name="Busqueda" value="@Model.Busqueda" />
            <section class="panel-glass">
                <div class="panel-head">
                    <i class="bi bi-box-seam"></i>
                    @if (Model.Editando)
                    {
                        <h4>Formulario de Referencia</h4>
                        <span class="edit-chip">EDITANDO: @Model.CodigoOriginal</span>
                    }
                    else
                    {
                        <h4>Nueva Referencia</h4>
                    }
                </div>
                <div class="form-grid">
                    <div class="field"><label for="Nuevo_Codigo_Fix">Código Fix <span class="req">*</span></label><input asp-for="Nuevo.Codigo_Fix" class="neon-input" placeholder="Ej: 103.00617" /></div>
                    <div class="field"><label for="Nuevo_Referencia">Referencia <span class="req">*</span></label><input asp-for="Nuevo.Referencia" class="neon-input" placeholder="Ej: ENG-2016-001" /></div>
                    <div class="field span-2"><label for="Nuevo_Descripcion">Nombre <span class="req">*</span></label><input asp-for="Nuevo.Descripcion" class="neon-input" placeholder="Nombre del producto" /></div>
                    <div class="field span-2"><label for="Nuevo_Nombre_Generico">Nombre Genérico</label><input asp-for="Nuevo.Nombre_Generico" class="neon-input" /></div>
                    <div class="field"><label for="Extra_Proveedor">Proveedor</label><input type="text" class="neon-input" id="Extra_Proveedor" name="Extra_Proveedor" /></div>
                    <div class="field"><label for="Extra_Linea">Línea</label><input type="text" class="neon-input" id="Extra_Linea" name="Extra_Linea" /></div>
                    <div class="field span-2"><label for="Extra_NombreRegSanitario">Nombre en Registro Sanitario</label><input type="text" class="neon-input" id="Extra_NombreRegSanitario" name="Extra_NombreRegSanitario" /></div>
                    <div class="field"><label for="Extra_Iva">IVA</label><input type="text" class="neon-input" id="Extra_Iva" name="Extra_Iva" /></div>
                    <div class="field"><label for="Extra_TipoIva">Tipo de IVA</label><input type="text" class="neon-input" id="Extra_TipoIva" name="Extra_TipoIva" /></div>
                    <div class="field"><label for="Extra_Pos">Artículo en POS</label><input type="text" class="neon-input" id="Extra_Pos" name="Extra_Pos" /></div>
                    <div class="field span-2"><label for="Extra_LineaNegocio">Línea de Negocio en el Mercado</label><input type="text" class="neon-input" id="Extra_LineaNegocio" name="Extra_LineaNegocio" /></div>
                    <div class="field"><label for="Extra_UnidadMedida">Unidad de Medida</label><input type="text" class="neon-input" id="Extra_UnidadMedida" name="Extra_UnidadMedida" /></div>
                    <div class="field span-2"><label for="Extra_Presentacion">Presentación Estéril / No Estéril</label><input type="text" class="neon-input" id="Extra_Presentacion" name="Extra_Presentacion" /></div>
                    <div class="field"><label for="Extra_Marca">Marca</label><input type="text" class="neon-input" id="Extra_Marca" name="Extra_Marca" /></div>
                    <div class="field"><label for="Extra_Especialidad">Especialidad</label><input type="text" class="neon-input" id="Extra_Especialidad" name="Extra_Especialidad" /></div>
                    <div class="field"><label for="Extra_Material">Material</label><input type="text" class="neon-input" id="Extra_Material" name="Extra_Material" /></div>
                    <div class="field"><label for="Extra_Calibre">Calibre</label><input type="text" class="neon-input" id="Extra_Calibre" name="Extra_Calibre" /></div>
                    <div class="field"><label for="Extra_Peso">Peso en /gr de la unidad</label><input type="text" class="neon-input" id="Extra_Peso" name="Extra_Peso" /></div>
                    <div class="field"><label for="Extra_UnidadVenta">Unidad de Venta</label><input type="text" class="neon-input" id="Extra_UnidadVenta" name="Extra_UnidadVenta" /></div>
                    <div class="field span-2"><label for="Extra_CantEmpaque">Cantidad x Unidad de Empaque</label><input type="text" class="neon-input" id="Extra_CantEmpaque" name="Extra_CantEmpaque" /></div>
                    <div class="field span-2"><label for="Nuevo_Fabricante">Nombre del Fabricante</label><input asp-for="Nuevo.Fabricante" class="neon-input" placeholder="Ej: ENGIMPLAN" /></div>
                    <div class="field span-2"><label for="Extra_DireccionProveedor">Dirección del Proveedor</label><input type="text" class="neon-input" id="Extra_DireccionProveedor" name="Extra_DireccionProveedor" /></div>
                    <div class="field"><label for="Nuevo_Registro_Invima">Registro INVIMA</label><input asp-for="Nuevo.Registro_Invima" class="neon-input" placeholder="Ej: 2016DM-0015253" /></div>
                    <div class="field"><label for="Nuevo_Pais_Origen">País de Origen</label><input asp-for="Nuevo.Pais_Origen" class="neon-input" /></div>
                    <div class="field span-2"><label for="Nuevo_Clasificacion_Riesgo">Clasificación de Riesgo según INVIMA</label><input asp-for="Nuevo.Clasificacion_Riesgo" class="neon-input" placeholder="Ej: II" /></div>
                    <div class="field"><label for="Nuevo_Tipo_Producto">Tipo de Producto</label><input asp-for="Nuevo.Tipo_Producto" class="neon-input" /></div>
                    <div class="field"><label for="Nuevo_Fecha_Vencimiento_Invima">Vencimiento INVIMA</label><input asp-for="Nuevo.Fecha_Vencimiento_Invima" type="date" asp-format="{0:yyyy-MM-dd}" class="neon-input" /></div>
                </div>
                <div class="form-actions">
                    <button type="button" class="neon-btn ghost" onclick="importar()"><i class="bi bi-upload"></i> Importar</button>
                    <button type="button" class="neon-btn" onclick="nuevaReferencia()"><i class="bi bi-plus-circle"></i> Nueva Referencia +</button>
                    <button type="submit" class="neon-btn ok"><i class="bi bi-save2"></i> Guardar Cambios</button>
                </div>
            </section>
        </form>

        <section class="panel-glass">
            <div class="panel-head"><i class="bi bi-search"></i><h4>Listado de Referencias</h4></div>
            <form method="get" class="search-row">
                <input type="text" name="busqueda" value="@Model.Busqueda" class="neon-input" placeholder="Buscar por referencia o código…" />
                <button type="submit" class="neon-btn"><i class="bi bi-search"></i> Buscar</button>
                <a href="/Admin/Database/Referencias" class="neon-btn ghost"><i class="bi bi-x-circle"></i> Limpiar</a>
            </form>
            @if (Model.Lista != null && Model.Lista.Any())
            {
                <div class="table-wrap">
                    <table class="neon-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Referencia</th>
                                <th>Descripción</th>
                                <th>Reg. Invima</th>
                                <th>Fabricante</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Lista)
                            {
                                <tr>
                                    <td class="td-code">@p.Codigo_Fix</td>
                                    <td>@p.Referencia</td>
                                    <td>@p.Descripcion</td>
                                    <td class="td-soft">@p.Registro_Invima</td>
                                    <td>@p.Fabricante</td>
                                    <td class="td-actions">
                                        <a class="btn-glass" asp-page="/Admin/Database/Referencias" asp-route-busqueda="@Model.Busqueda" asp-route-editar="@p.Codigo_Fix"><i class="bi bi-pencil"></i> Editar</a>
                                        <form method="post" asp-page-handler="Eliminar" onsubmit="return confirm('¿Eliminar la referencia @p.Codigo_Fix? Esta acción no se puede deshacer.');">
                                            <input type="hidden" name="codigo" value="@p.Codigo_Fix" />
                                            <input type="hidden" name="Busqueda" value="@Model.Busqueda" />
                                            <button type="submit" class="btn-glass bad"><i class="bi bi-trash"></i> Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state"><i class="bi bi-info-circle"></i> @(string.IsNullOrWhiteSpace(Model.Busqueda) ? "Aún no hay referencias." : $"Sin resultados para '{Model.Busqueda}'.")</div>
            }
        </section>
    </div>

    <script>
        (function () {
            try {
                var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (reduce) return;
                var canvas = document.getElementById('particles');
                if (!canvas || !canvas.getContext) return;
                var ctx = canvas.getContext('2d');
                var w, h, particles = [];
                var COLORS = ['34,211,238', '243,146,0', '255,77,141'];
                function resize() {
                    w = canvas.width = window.innerWidth;
                    h = canvas.height = window.innerHeight;
                    var count = Math.min(90, Math.floor((w * h) / 16000));
                    particles = [];
                    for (var i = 0; i < count; i++) {
                        particles.push({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4, r: Math.random() * 1.8 + 0.6, c: COLORS[Math.floor(Math.random() * COLORS.length)] });
                    }
                }
                function draw() {
                    ctx.clearRect(0, 0, w, h);
                    for (var i = 0; i < particles.length; i++) {
                        var p = particles[i];
                        p.x += p.vx; p.y += p.vy;
                        if (p.x < 0 || p.x > w) p.vx *= -1;
                        if (p.y < 0 || p.y > h) p.vy *= -1;
                        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                        ctx.fillStyle = 'rgba(' + p.c + ',0.8)'; ctx.fill();
                        for (var j = i + 1; j < particles.length; j++) {
                            var q = particles[j];
                            var dx = p.x - q.x, dy = p.y - q.y, dist = Math.sqrt(dx * dx + dy * dy);
                            if (dist < 120) {
                                ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
                                ctx.strokeStyle = 'rgba(' + p.c + ',' + (0.12 * (1 - dist / 120)) + ')';
                                ctx.lineWidth = 0.6; ctx.stroke();
                            }
                        }
                    }
                    requestAnimationFrame(draw);
                }
                resize(); window.addEventListener('resize', resize); draw();
            } catch (e) { }
        })();
    </script>

    <script>
        document.querySelectorAll('#formRef input[type="text"]').forEach(function (inp) {
            inp.addEventListener('input', function () {
                var v = inp.value, u = v.toUpperCase();
                if (u !== v) inp.value = u;
            });
        });

        function nuevaReferencia() {
            document.querySelectorAll('#formRef input[type="text"]').forEach(function (i) { i.value = ''; });
            document.querySelectorAll('#formRef input[type="date"]').forEach(function (i) { i.value = ''; });
            var h = document.getElementById('CodigoOriginal');
            if (h) h.value = '';
            var c = document.getElementById('Nuevo_Codigo_Fix');
            if (c) c.focus();
        }

        function importar() {
            alert('Importación masiva en construcción.\nPor hoy el cargue se hace por SQL/Excel.');
        }
    </script>
</body>
