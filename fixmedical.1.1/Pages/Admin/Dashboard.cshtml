@page
@model fixmedical._1._1.Pages.Admin.DashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Administración - FixMedical";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/LOGO FIX CORTO_sin_fondo (1).png" />
    <title>Administración - FixMedical</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --bg-0: #05070f;
                --bg-1: #0a1226;
                --bg-2: #0d1b3a;
                --azul: #004b87;
                --azul-2: #002d54;
                --naranja: #f39200;
                --neon-cyan: #22d3ee;
                --neon-magenta: #ff4d8d;
                --ok: #34d399;
                --txt: #eaf2ff;
                --txt-soft: #8fb3d9;
                --glass: rgba(13,20,40,.55);
                --glass-border: rgba(255,255,255,.08);
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                background: var(--bg-0);
                color: var(--txt);
                font-family: 'Segoe UI',Tahoma,sans-serif;
                overflow-x: hidden;
            }

            .bg {
                position: fixed;
                inset: 0;
                z-index: 0;
                overflow: hidden;
            }

            .bg-gradient {
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg,var(--bg-0),var(--bg-1) 45%,var(--bg-2));
                background-size: 200% 200%;
                animation: gs 18s ease infinite;
            }

            .blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(90px);
                opacity: .45;
                mix-blend-mode: screen;
            }

            .b1 {
                width: 520px;
                height: 520px;
                background: radial-gradient(circle at 30% 30%,var(--naranja),transparent 60%);
                top: -140px;
                left: -120px;
                animation: f1 22s ease-in-out infinite;
            }

            .b2 {
                width: 600px;
                height: 600px;
                background: radial-gradient(circle at 70% 40%,var(--azul),transparent 60%);
                bottom: -200px;
                right: -160px;
                animation: f2 26s ease-in-out infinite;
            }

            .b3 {
                width: 420px;
                height: 420px;
                background: radial-gradient(circle at 50% 50%,var(--neon-cyan),transparent 60%);
                top: 30%;
                left: 48%;
                opacity: .22;
                animation: f3 30s ease-in-out infinite;
            }

            .grid-overlay {
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(34,211,238,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.06) 1px,transparent 1px);
                background-size: 44px 44px;
                -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%,#000,transparent 80%);
                mask-image: radial-gradient(ellipse 80% 70% at 50% 30%,#000,transparent 80%);
            }

            #particles {
                position: fixed;
                inset: 0;
                z-index: 1;
                pointer-events: none;
            }

            .navbar-neon {
                position: sticky;
                top: 0;
                z-index: 50;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 28px;
                background: rgba(5,7,15,.55);
                -webkit-backdrop-filter: blur(14px);
                backdrop-filter: blur(14px);
                border-bottom: 1px solid var(--glass-border);
                box-shadow: 0 6px 24px rgba(0,0,0,.4);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                text-decoration: none;
            }

            .brand-logo {
                height: 55px;
                width: auto;
                display: block;
                filter: drop-shadow(0 0 8px rgba(243,146,0,.55)) drop-shadow(0 0 18px rgba(243,146,0,.28));
                transition: filter .25s,transform .25s;
            }

            .brand:hover .brand-logo {
                filter: drop-shadow(0 0 12px rgba(243,146,0,.85)) drop-shadow(0 0 26px rgba(34,211,238,.35));
                transform: scale(1.04);
            }

            .nav-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                color: var(--txt-soft);
                font-size: .85rem;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .btn-glass {
                background: rgba(255,255,255,.06);
                border: 1px solid rgba(255,255,255,.15);
                color: var(--txt);
                border-radius: 8px;
                padding: 7px 16px;
                font-size: .85rem;
                cursor: pointer;
                text-decoration: none;
                transition: .25s;
            }

                .btn-glass:hover {
                    border-color: var(--naranja);
                    box-shadow: 0 0 16px rgba(243,146,0,.35);
                    color: #fff;
                }

            .container-neon {
                position: relative;
                z-index: 2;
                max-width: 1100px;
                margin: 0 auto;
                padding: 40px 24px 60px;
            }

            .welcome-glass {
                position: relative;
                overflow: hidden;
                background: var(--glass);
                -webkit-backdrop-filter: blur(16px);
                backdrop-filter: blur(16px);
                border: 1px solid var(--glass-border);
                border-radius: 20px;
                padding: 32px 36px;
                box-shadow: 0 20px 60px rgba(0,0,0,.45);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 40px;
                animation: ci .7s cubic-bezier(.2,.8,.2,1) both;
            }

                .welcome-glass::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 10%;
                    right: 10%;
                    height: 2px;
                    background: linear-gradient(90deg,transparent,var(--naranja),var(--neon-cyan),transparent);
                    filter: blur(1px);
                    opacity: .85;
                }

                .welcome-glass h1 {
                    margin: 0 0 6px;
                    font-size: 2rem;
                    font-weight: 800;
                    text-shadow: 0 0 22px rgba(34,211,238,.25);
                }

                .welcome-glass p {
                    margin: 0;
                    color: var(--txt-soft);
                }

            .badge-admin {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: .7rem;
                letter-spacing: 2px;
                text-transform: uppercase;
                font-weight: 700;
                color: var(--neon-cyan);
                background: rgba(34,211,238,.08);
                border: 1px solid rgba(34,211,238,.25);
                padding: 5px 12px;
                border-radius: 999px;
                margin-bottom: 12px;
            }

            .welcome-icon {
                font-size: 3.4rem;
                color: var(--neon-cyan);
                opacity: .35;
                text-shadow: 0 0 24px rgba(34,211,238,.5);
            }

            .cards-row {
                display: flex;
                justify-content: center;
                gap: 22px;
                flex-wrap: wrap;
            }

            .glass-card {
                width: 300px;
                background: var(--glass);
                -webkit-backdrop-filter: blur(16px);
                backdrop-filter: blur(16px);
                border: 1px solid var(--glass-border);
                border-radius: 20px;
                padding: 34px 28px;
                text-align: center;
                position: relative;
                overflow: hidden;
                box-shadow: 0 16px 44px rgba(0,0,0,.4);
                transition: transform .3s,box-shadow .3s,border-color .3s;
                animation: ci .8s cubic-bezier(.2,.8,.2,1) both;
            }

                .glass-card:hover {
                    transform: translateY(-6px);
                    border-color: rgba(243,146,0,.35);
                    box-shadow: 0 22px 60px rgba(0,0,0,.5),0 0 30px rgba(243,146,0,.18);
                }

            .icon-box {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.9rem;
            }

            .ib-orange {
                background: rgba(243,146,0,.12);
                color: var(--naranja);
                box-shadow: 0 0 22px rgba(243,146,0,.25);
            }

            .ib-cyan {
                background: rgba(34,211,238,.1);
                color: var(--neon-cyan);
                box-shadow: 0 0 22px rgba(34,211,238,.25);
            }

            .ib-ok {
                background: rgba(52,211,153,.1);
                color: var(--ok);
                box-shadow: 0 0 22px rgba(52,211,153,.25);
            }

            .glass-card h4 {
                margin: 0 0 22px;
                font-weight: 800;
                color: #fff;
            }

            .neon-btn {
                display: inline-block;
                width: 100%;
                padding: 13px;
                border: 1px solid rgba(243,146,0,.35);
                border-radius: 10px;
                font-size: 15px;
                font-weight: 700;
                letter-spacing: .5px;
                color: #fff;
                cursor: pointer;
                text-decoration: none;
                text-align: center;
                background: linear-gradient(135deg,var(--azul) 0%,var(--azul-2) 100%);
                box-shadow: 0 8px 24px rgba(0,75,135,.45);
                transition: transform .18s,box-shadow .25s,filter .25s;
                position: relative;
                overflow: hidden;
            }

                .neon-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 30px rgba(0,75,135,.6),0 0 24px rgba(243,146,0,.5);
                    filter: brightness(1.08);
                    color: #fff;
                }

                .neon-btn::after {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: -60%;
                    width: 40%;
                    height: 100%;
                    background: linear-gradient(120deg,transparent,rgba(255,255,255,.28),transparent);
                    transform: skewX(-20deg);
                    transition: left .6s;
                }

                .neon-btn:hover::after {
                    left: 130%;
                }

            @@keyframes gs {
                0% {
                    background-position: 0 50%;
                }

                50% {
                    background-position: 100% 50%;
                }

                100% {
                    background-position: 0 50%;
                }
            }

            @@keyframes f1 {
                0%, 100% {
                    transform: translate(0,0) scale(1);
                }

                50% {
                    transform: translate(60px,50px) scale(1.12);
                }
            }

            @@keyframes f2 {
                0%, 100% {
                    transform: translate(0,0) scale(1);
                }

                50% {
                    transform: translate(-70px,-40px) scale(1.1);
                }
            }

            @@keyframes f3 {
                0%, 100% {
                    transform: translate(0,0) scale(1);
                }

                50% {
                    transform: translate(-50px,40px) scale(1.15);
                }
            }

            @@keyframes ci {
                from {
                    opacity: 0;
                    transform: translateY(26px) scale(.97);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @@media (prefers-reduced-motion:reduce) {
                .blob, .bg-gradient, .welcome-glass, .glass-card {
                    animation: none !important;
                }

                .neon-btn::after {
                    display: none;
                }
            }

            @@media (max-width:600px) {
                .welcome-glass {
                    flex-direction: column;
                    text-align: center;
                    padding: 26px 22px;
                }

                .welcome-icon {
                    display: none;
                }

                .navbar-neon {
                    padding: 12px 16px;
                }

                .user-chip {
                    display: none;
                }

                .container-neon {
                    padding: 28px 16px 48px;
                }
            }
    </style>
</head>
<body>

    <div class="bg" aria-hidden="true">
        <div class="bg-gradient"></div>
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="blob b3"></div>
        <div class="grid-overlay"></div>
    </div>
    <canvas id="particles" aria-hidden="true"></canvas>

    <nav class="navbar-neon">
        <a href="/Dashboard" class="brand" title="FixMedical">
            <img src="~/images/LOGO FIX CORTO_sin_fondo (1).png" alt="FixMedical" class="brand-logo" />
        </a>
        <div class="nav-right">
            <span class="user-chip"><i class="bi bi-person-circle"></i> @Model.NombreUsuario (@Model.RolUsuario)</span>
            <a href="/Dashboard" class="btn-glass"><i class="bi bi-arrow-left"></i> Inicio</a>
            <form method="post" asp-page="/Dashboard" asp-page-handler="Logout" style="margin:0;">
                <button type="submit" class="btn-glass">Cerrar Sesión</button>
            </form>
        </div>
    </nav>

    <div class="container-neon">

        <section class="welcome-glass">
            <div>
                <span class="badge-admin"><i class="bi bi-shield-lock-fill"></i> Zona de administración</span>
                <h1>¡Hola, @Model.NombreUsuario!</h1>
                <p>Panel de administración de FixMedical. Gestiona usuarios, cirugías programadas y la base de datos.</p>
            </div>
            <i class="bi bi-gear-wide-connected welcome-icon"></i>
        </section>

        <div class="cards-row">
            <div class="glass-card">
                <div class="icon-box ib-orange"><i class="bi bi-people-fill"></i></div>
                <h4>Registrar usuarios</h4>
                <a href="/Admin/Register" class="neon-btn">Ingresar</a>
            </div>
            <div class="glass-card">
                <div class="icon-box ib-cyan"><i class="bi bi-calendar2-week"></i></div>
                <h4>Programaciones</h4>
                <a href="/Admin/Programaciones" class="neon-btn">Ingresar</a>   
            </div>
            <div class="glass-card">
                <div class="icon-box ib-ok"><i class="bi bi-database-fill-gear"></i></div>
                <h4>Database</h4>
                <a href="/Admin/Database" class="neon-btn">Ingresar</a>
            </div>
        </div>
    </div>

    <script>
            (function() { try { var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches; if (reduce) return; var canvas = document.getElementById('particles'); if (!canvas || !canvas.getContext) return; var ctx = canvas.getContext('2d'); var w, h, particles = []; var COLORS = ['34,211,238', '243,146,0', '255,77,141']; function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; var count = Math.min(90, Math.floor((w * h) / 16000)); particles = []; for (var i = 0; i < count; i++)particles.push({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .4, vy: (Math.random() - .5) * .4, r: Math.random() * 1.8 + .6, c: COLORS[Math.floor(Math.random() * COLORS.length)] }); } function draw() { ctx.clearRect(0, 0, w, h); for (var i = 0; i < particles.length; i++) { var p = particles[i]; p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fillStyle = 'rgba(' + p.c + ',0.8)'; ctx.fill(); for (var j = i + 1; j < particles.length; j++) { var q = particles[j]; var dx = p.x - q.x, dy = p.y - q.y, dist = Math.sqrt(dx * dx + dy * dy); if (dist < 120) { ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.strokeStyle = 'rgba(' + p.c + ',' + (0.12 * (1 - dist / 120)) + ')'; ctx.lineWidth = 0.6; ctx.stroke(); } } } requestAnimationFrame(draw); } resize(); window.addEventListener('resize', resize); draw(); } catch (e) { } })();
    </script>
</body>
</html>