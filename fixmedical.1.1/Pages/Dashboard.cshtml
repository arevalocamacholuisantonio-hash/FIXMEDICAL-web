@page
@model fixmedical._1._1.Pages.DashboardModel
@{
    Layout = null;
    ViewData["Title"] = "Inicio - FixMedical";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inicio - FixMedical</title>
    <link rel="icon" type="image/png" sizes="40x40" href="~/images/LOGO FIX CORTO_sin_fondo (1).png" />
    <link rel="apple-touch-icon" href="~/images/LOGO FIX CORTO_sin_fondo (1).png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --bg-0: #05070f;
                --bg-1: #0a1226;
                --bg-2: #0d1b3a;
                --azul: #004b87;
                --azul-2: #002d54;
                --naranja: #f39200;
                --neon-cyan: #22d3ee;
                --neon-magenta: #ff4d8d;
                --ok: #34d399;
                --txt: #eaf2ff;
                --txt-soft: #8fb3d9;
                --glass: rgba(13, 20, 40, .55);
                --glass-border: rgba(255, 255, 255, .08);
            }

            * { box-sizing: border-box; }
            html, body { height: 100%; }

            body {
                margin: 0;
                background-color: var(--bg-0);
                color: var(--txt);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                overflow-x: hidden;
            }

            .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
            .bg-gradient {
                position: absolute; inset: 0;
                background: linear-gradient(135deg, var(--bg-0) 0%, var(--bg-1) 45%, var(--bg-2) 100%);
                background-size: 200% 200%;
                animation: gradientShift 18s ease infinite;
            }
            .blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .5; mix-blend-mode: screen; will-change: transform; }
            .b1 { width: 520px; height: 520px; background: radial-gradient(circle at 30% 30%, var(--naranja), transparent 60%); top: -120px; left: -100px; animation: float1 22s ease-in-out infinite; }
            .b2 { width: 620px; height: 620px; background: radial-gradient(circle at 70% 40%, var(--azul), transparent 60%); bottom: -180px; right: -140px; animation: float2 26s ease-in-out infinite; }
            .b3 { width: 420px; height: 420px; background: radial-gradient(circle at 50% 50%, var(--neon-cyan), transparent 60%); top: 38%; left: 55%; opacity: .25; animation: float3 30s ease-in-out infinite; }
            .grid-overlay {
                position: absolute; inset: 0;
                background-image:
                    linear-gradient(rgba(34, 211, 238, .06) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(34, 211, 238, .06) 1px, transparent 1px);
                background-size: 44px 44px;
                -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 0%, transparent 80%);
                mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 0%, transparent 80%);
            }
            #particles { position: fixed; inset: 0; z-index: 1; pointer-events: none; }

            .navbar-neon {
                position: sticky; top: 0; z-index: 50;
                display: flex; align-items: center; justify-content: space-between;
                padding: 16px 28px;
                background: rgba(5, 7, 15, .55);
                -webkit-backdrop-filter: blur(14px) saturate(140%);
                backdrop-filter: blur(14px) saturate(140%);
                border-bottom: 1px solid var(--glass-border);
                box-shadow: 0 6px 24px rgba(0, 0, 0, .4);
            }
            .brand { display: inline-flex; align-items: center; text-decoration: none; }
            .brand-logo {
                height: 55px; width: auto; display: block;
                filter: drop-shadow(0 0 8px rgba(243,146,0,.55)) drop-shadow(0 0 18px rgba(243,146,0,.28));
                transition: filter .25s, transform .25s;
            }
            .brand:hover .brand-logo {
                filter: drop-shadow(0 0 12px rgba(243,146,0,.85)) drop-shadow(0 0 26px rgba(34,211,238,.35));
                transform: scale(1.04);
            }
            .nav-right { display: flex; align-items: center; gap: 16px; }
            .user-chip { color: var(--txt-soft); font-size: .85rem; display: flex; align-items: center; gap: 6px; }
            .btn-glass {
                background: rgba(255, 255, 255, .06);
                border: 1px solid rgba(255, 255, 255, .15);
                color: var(--txt); border-radius: 8px; padding: 7px 16px;
                font-size: .85rem; cursor: pointer; transition: border-color .25s, box-shadow .25s, color .25s;
            }
                .btn-glass:hover { border-color: var(--naranja); box-shadow: 0 0 16px rgba(243, 146, 0, .35); color: #fff; }

            .container-neon { position: relative; z-index: 2; max-width: 1100px; margin: 0 auto; padding: 40px 24px 60px; }

            .welcome-glass {
                position: relative; overflow: hidden;
                background: var(--glass);
                -webkit-backdrop-filter: blur(16px) saturate(140%);
                backdrop-filter: blur(16px) saturate(140%);
                border: 1px solid var(--glass-border);
                border-radius: 20px; padding: 32px 36px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, .45);
                display: flex; align-items: center; justify-content: space-between; gap: 20px;
                margin-bottom: 40px;
                animation: cardIn .7s cubic-bezier(.2, .8, .2, 1) both;
            }
                .welcome-glass::before {
                    content: ""; position: absolute; top: 0; left: 10%; right: 10%; height: 2px;
                    background: linear-gradient(90deg, transparent, var(--naranja), var(--neon-cyan), transparent);
                    filter: blur(1px); opacity: .85;
                }
            .welcome-glass h1 { margin: 0 0 6px; font-size: 2rem; font-weight: 800; text-shadow: 0 0 22px rgba(34, 211, 238, .25); }
            .welcome-glass p { margin: 0; color: var(--txt-soft); }
            .welcome-icon { font-size: 3.4rem; color: var(--neon-cyan); opacity: .35; text-shadow: 0 0 24px rgba(34, 211, 238, .5); }

            .badge-role { display: inline-flex; align-items: center; gap: 6px; font-size: .7rem; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; padding: 5px 12px; border-radius: 999px; margin-bottom: 12px; }
            .badge-admin { color: var(--neon-cyan); background: rgba(34,211,238,.08); border: 1px solid rgba(34,211,238,.25); }
            .badge-eqc   { color: var(--naranja); background: rgba(243,146,0,.08); border: 1px solid rgba(243,146,0,.25); }
            .badge-com   { color: var(--ok);      background: rgba(52,211,153,.08); border: 1px solid rgba(52,211,153,.25); }

            .cards-row { display: flex; justify-content: center; margin-bottom: 44px; gap: 22px; flex-wrap: wrap; }
            .glass-card {
                width: 100%; max-width: 360px;
                background: var(--glass);
                -webkit-backdrop-filter: blur(16px) saturate(140%);
                backdrop-filter: blur(16px) saturate(140%);
                border: 1px solid var(--glass-border);
                border-radius: 20px; padding: 34px 30px;
                text-align: center; position: relative; overflow: hidden;
                box-shadow: 0 16px 44px rgba(0, 0, 0, .4);
                transition: transform .3s, box-shadow .3s, border-color .3s;
                animation: cardIn .8s cubic-bezier(.2, .8, .2, 1) both;
            }
                .glass-card:hover { transform: translateY(-6px); border-color: rgba(243, 146, 0, .35); box-shadow: 0 22px 60px rgba(0, 0, 0, .5), 0 0 30px rgba(243, 146, 0, .18); }
            .icon-box {
                width: 64px; height: 64px; border-radius: 16px; margin: 0 auto 20px;
                display: flex; align-items: center; justify-content: center; font-size: 1.9rem;
            }
            .ib-orange { background: rgba(243, 146, 0, .12); color: var(--naranja); box-shadow: 0 0 22px rgba(243, 146, 0, .25); }
            .ib-cyan   { background: rgba(34, 211, 238, .1); color: var(--neon-cyan); box-shadow: 0 0 22px rgba(34, 211, 238, .25); }
            .ib-ok     { background: rgba(52, 211, 153, .1); color: var(--ok); box-shadow: 0 0 22px rgba(52, 211, 153, .25); }
            .glass-card h4 { margin: 0 0 22px; font-weight: 800; color: #fff; }

            .neon-btn {
                display: inline-block; width: 100%; padding: 13px; border: 1px solid rgba(243, 146, 0, .35);
                border-radius: 10px; font-size: 15px; font-weight: 700; letter-spacing: .5px; color: #fff;
                cursor: pointer; text-decoration: none; text-align: center;
                background: linear-gradient(135deg, var(--azul) 0%, var(--azul-2) 100%);
                box-shadow: 0 8px 24px rgba(0, 75, 135, .45), 0 0 0 1px rgba(34, 211, 238, .12) inset;
                transition: transform .18s, box-shadow .25s, filter .25s; position: relative; overflow: hidden;
            }
                .neon-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0, 75, 135, .6), 0 0 24px rgba(243, 146, 0, .5); filter: brightness(1.08); color: #fff; }
                .neon-btn::after {
                    content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
                    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, .28), transparent);
                    transform: skewX(-20deg); transition: left .6s;
                }
                .neon-btn:hover::after { left: 130%; }

            .neon-btn-sm {
                display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; width: auto;
                border: 1px solid rgba(243, 146, 0, .35); border-radius: 9px; font-size: 13px; font-weight: 700;
                color: #fff; cursor: pointer; background: linear-gradient(135deg, var(--azul) 0%, var(--azul-2) 100%);
                box-shadow: 0 6px 18px rgba(0, 75, 135, .4); transition: transform .18s, box-shadow .25s, filter .25s;
                position: relative; overflow: hidden;
            }
                .neon-btn-sm:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0, 75, 135, .55), 0 0 20px rgba(243, 146, 0, .5); filter: brightness(1.08); }
                .neon-btn-sm::after {
                    content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
                    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, .28), transparent);
                    transform: skewX(-20deg); transition: left .6s;
                }
                .neon-btn-sm:hover::after { left: 130%; }

            .panel-glass {
                background: var(--glass);
                -webkit-backdrop-filter: blur(16px) saturate(140%);
                backdrop-filter: blur(16px) saturate(140%);
                border: 1px solid var(--glass-border);
                border-radius: 20px; padding: 28px 30px;
                box-shadow: 0 16px 44px rgba(0, 0, 0, .4);
                animation: cardIn .9s cubic-bezier(.2, .8, .2, 1) both;
                margin-bottom: 30px;
            }
            .panel-head { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
            .panel-head h4 { margin: 0; font-weight: 800; color: #fff; }
            .panel-head i { color: var(--neon-cyan); text-shadow: 0 0 14px rgba(34, 211, 238, .5); font-size: 1.3rem; }

            .table-wrap { overflow-x: auto; }
            .neon-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
                .neon-table thead th {
                    color: var(--neon-cyan); text-transform: uppercase; font-size: 11px; letter-spacing: .7px;
                    padding: 12px 14px; border-bottom: 1px solid rgba(34, 211, 238, .25); text-align: left; white-space: nowrap;
                }
                .neon-table tbody td { padding: 14px; border-bottom: 1px solid rgba(255, 255, 255, .06); color: var(--txt); }
                .neon-table tbody tr { transition: background .2s; }
                .neon-table tbody tr:hover { background: rgba(34, 211, 238, .05); }
            .td-cirujano { font-weight: 700; text-shadow: 0 0 10px rgba(243, 146, 0, .2); }
            .td-fecha { color: var(--txt-soft); white-space: nowrap; }
            .td-center { text-align: center; }

            .badge-neon { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; }
            .badge-ok   { color: #7dffb8; background: rgba(40, 167, 69, .12); border: 1px solid rgba(40, 167, 69, .45); }
            .badge-pend { color: #ffc46b; background: rgba(243, 146, 0, .12); border: 1px solid rgba(243, 146, 0, .45); }
            .badge-bad  { color: #ff8fb3; background: rgba(220, 38, 38, .12); border: 1px solid rgba(220, 38, 38, .45); }
            .badge-sol  { color: #a5f3fc; background: rgba(34, 211, 238, .12); border: 1px solid rgba(34, 211, 238, .45); }

            .empty-state { color: var(--txt-soft); display: flex; align-items: center; gap: 8px; padding: 6px 2px; }

            .modal-neon {
                position: fixed; inset: 0; z-index: 200000; display: none;
                align-items: center; justify-content: center;
                background: rgba(2, 4, 10, .72);
                -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px);
            }
            .modal-neon-box {
                width: 400px; max-width: 92%; text-align: center; position: relative; overflow: hidden;
                background: rgba(13, 20, 40, .85);
                -webkit-backdrop-filter: blur(18px) saturate(140%);
                backdrop-filter: blur(18px) saturate(140%);
                border: 1px solid var(--glass-border); border-radius: 18px; padding: 28px 30px;
                box-shadow: 0 24px 70px rgba(0, 0, 0, .6);
                animation: cardIn .4s cubic-bezier(.2, .8, .2, 1) both;
            }
                .modal-neon-box::before {
                    content: ""; position: absolute; top: 0; left: 14%; right: 14%; height: 2px;
                    background: linear-gradient(90deg, transparent, var(--neon-magenta), var(--naranja), transparent);
                    filter: blur(1px); opacity: .9;
                }
            .modal-neon-box h5 { margin: 0 0 4px; font-weight: 800; color: #fff; }
            .modal-neon-box h5 i { color: var(--neon-magenta); text-shadow: 0 0 14px rgba(255, 77, 141, .6); }
            .crono {
                font-size: 2.4rem; font-weight: 800; letter-spacing: 2px; margin: 12px 0 18px;
                color: #ff5a6e; text-shadow: 0 0 20px rgba(255, 77, 109, .6);
            }
                .crono i { font-size: 1.8rem; }
            .modal-neon-box .hint { color: var(--txt-soft); font-size: 13px; margin-bottom: 16px; }
            .modal-stack { display: flex; flex-direction: column; gap: 10px; }
            .link-soft { background: none; border: none; color: var(--txt-soft); cursor: pointer; font-size: 13px; margin-top: 12px; text-decoration: underline; }
                .link-soft:hover { color: #fff; }

            @@keyframes gradientShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
            @@keyframes float1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(60px,50px) scale(1.12); } }
            @@keyframes float2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-70px,-40px) scale(1.10); } }
            @@keyframes float3 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-50px,40px) scale(1.15); } }
            @@keyframes cardIn { from { opacity: 0; transform: translateY(26px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

            @@media (prefers-reduced-motion: reduce) {
                .blob, .bg-gradient, .welcome-glass, .glass-card, .panel-glass, .modal-neon-box { animation: none !important; }
                .neon-btn::after, .neon-btn-sm::after { display: none; }
            }

            @@media (max-width: 600px) {
                .welcome-glass { flex-direction: column; text-align: center; padding: 26px 22px; }
                .welcome-icon { display: none; }
                .navbar-neon { padding: 12px 16px; }
                .user-chip { display: none; }
                .container-neon { padding: 28px 16px 48px; }
            }
    </style>
</head>
<body>

    <div class="bg" aria-hidden="true">
        <div class="bg-gradient"></div>
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="blob b3"></div>
        <div class="grid-overlay"></div>
    </div>
    <canvas id="particles" aria-hidden="true"></canvas>

    <nav class="navbar-neon">
        <a href="/Dashboard" class="brand" title="FixMedical">
            <img src="~/images/LOGO FIX CORTO_sin_fondo (1).png" alt="FixMedical" class="brand-logo" />
        </a>
        <div class="nav-right">
            <span class="user-chip"><i class="bi bi-person-circle"></i> @Model.NombreUsuario (@Model.RolUsuario)</span>
            <form method="post" asp-page-handler="Logout" style="margin:0;">
                <button type="submit" class="btn-glass">Cerrar Sesión</button>
            </form>
        </div>
    </nav>

    <div class="container-neon">

        <!-- ===== WELCOME SEGÚN ROL ===== -->
        <section class="welcome-glass">
            <div>
                @if (Model.EsAdminView)
                {
                    <span class="badge-role badge-admin"><i class="bi bi-shield-fill-check"></i> Administrador</span>
                }
                else if (Model.EsEQCView)
                {
                    <span class="badge-role badge-eqc"><i class="bi bi-clipboard2-pulse-fill"></i> EQC</span>
                }
                else if (Model.EsComercialView)
                {
                    <span class="badge-role badge-com"><i class="bi bi-briefcase-fill"></i> Comercial</span>
                }
                <h1>¡Hola, @Model.NombreUsuario!</h1>
                <p>Bienvenido al sistema de gestión de osteosíntesis de FixMedical.</p>
            </div>
            <i class="bi bi-hospital welcome-icon"></i>
        </section>

        <!-- ===== TARJETAS POR ROL ===== -->
        <div class="cards-row">

            @if (Model.EsAdminView)
            {
                <div class="glass-card">
                    <div class="icon-box ib-orange"><i class="bi bi-shield-fill-check"></i></div>
                    <h4>Modo Administrador</h4>
                    <a href="/Admin/Dashboard" class="neon-btn">Ingresar</a>
                </div>
            }

            @if (Model.EsEQCView)
            {
                <div class="glass-card">
                    <div class="icon-box ib-cyan"><i class="bi bi-calendar2-week"></i></div>
                    <h4>Mis cirugías asignadas</h4>
                    <a href="/Admin/Programaciones" class="neon-btn">Ver historial</a>
                </div>
            }

            @if (Model.EsComercialView)
            {
                <div class="glass-card">
                    <div class="icon-box ib-ok"><i class="bi bi-file-earmark-medical-fill"></i></div>
                    <h4>Nueva solicitud de material</h4>
                    <a href="/Solicitudes/Crear" class="neon-btn">Crear solicitud</a>
                </div>
            }

        </div>

        <!-- ===== TABLA DE CIRUGÍAS (Admin y EQC) ===== -->
        @if (Model.EsAdminView || Model.EsEQCView)
        {
            <section class="panel-glass">
                <div class="panel-head">
                    <i class="bi bi-calendar2-week"></i>
                    <h4>
                        @if (Model.EsAdminView)
                        {
                            @:Cirugías programadas
                        }
                        else
                        {
                            @:Mis cirugías asignadas
                        }
                    </h4>
                </div>

                @if (Model.Programaciones.Any())
                {
                    <div class="table-wrap">
                        <table class="neon-table">
                            <thead>
                                <tr>
                                    <th>Cirujano</th>
                                    <th>Cirugía</th>
                                    <th>Fecha</th>
                                    <th class="td-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Programaciones)
                                {
                                    <tr>
                                        <td class="td-cirujano">@p.Cirujano</td>
                                        <td>@p.CirugiaProgramada</td>
                                        <td class="td-fecha">@p.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="td-center">
                                            <button type="button" class="neon-btn-sm" onclick="iniciarCirugia(@p.ID_Programacion)">
                                                <i class="bi bi-play-circle-fill"></i> INICIAR
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-info-circle"></i>
                        @if (Model.EsAdminView)
                        {
                            @:No hay cirugías programadas pendientes.
                        }
                        else
                        {
                            @:No tienes cirugías asignadas pendientes.
                        }
                    </div>
                }
            </section>
        }

        <!-- ===== HISTORIAL DE SOLICITUDES (solo Comercial) ===== -->
        @if (Model.EsComercialView)
        {
            <section class="panel-glass">
                <div class="panel-head">
                    <i class="bi bi-clock-history"></i>
                    <h4>Mis últimas solicitudes</h4>
                </div>

                @if (Model.MisSolicitudes.Any())
                {
                    <div class="table-wrap">
                        <table class="neon-table">
                            <thead>
                                <tr>
                                    <th>Nº Solicitud</th>
                                    <th>Paciente / Especialista</th>
                                    <th>Fecha</th>
                                    <th class="td-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.MisSolicitudes)
                                {
                                    <tr>
                                        <td><span class="badge-neon badge-sol">@s.NumeroSolicitud</span></td>
                                        <td>
                                            <div class="td-cirujano">@s.Especialista</div>
                                            <div style="color:var(--txt-soft); font-size:12px; margin-top:4px;">@s.NombrePaciente</div>
                                        </td>
                                        <td class="td-fecha">@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                        <td class="td-center">
                                            @if (s.Estado == "Aprobada")
                                            {
                                                <span class="badge-neon badge-ok">Aprobada</span>
                                            }
                                            else if (s.Estado == "Rechazada")
                                            {
                                                <span class="badge-neon badge-bad">Rechazada</span>
                                            }
                                            else
                                            {
                                                <span class="badge-neon badge-pend">Pendiente</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state"><i class="bi bi-info-circle"></i> Aún no has creado solicitudes. ¡Crea la primera arriba!</div>
                }
            </section>
        }

    </div>

    <!-- ===== MODAL INICIAR CIRUGÍA (fuera del container, correcto) ===== -->
    @if (Model.EsAdminView || Model.EsEQCView)
    {
        <div id="modalDoc" class="modal-neon">
            <div class="modal-neon-box">
                <h5><i class="bi bi-broadcast"></i> Cirugía iniciada</h5>
                <div class="crono"><i class="bi bi-stopwatch"></i> <span id="cronoModal">00:00:00</span></div>
                <p class="hint">Seleccione el documento a diligenciar:</p>
                <div class="modal-stack">
                    <button type="button" class="neon-btn" onclick="abrirHojaGasto()">
                        <i class="bi bi-file-earmark-medical-fill"></i> Hoja de Gasto
                    </button>
                    <button type="button" class="neon-btn" onclick="abrirTarjetaImplante()">
                        <i class="bi bi-card-checklist"></i> Tarjeta de Implante
                    </button>
                </div>
                <button type="button" class="link-soft" onclick="cerrarModalDoc()">Cancelar</button>
            </div>
        </div>
    }

    <script>
        (function () {
            try {
                var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (reduce) return;
                var canvas = document.getElementById('particles');
                if (!canvas || !canvas.getContext) return;
                var ctx = canvas.getContext('2d');
                var w, h, particles = [];
                var COLORS = ['34,211,238', '243,146,0', '255,77,141'];
                function resize() {
                    w = canvas.width = window.innerWidth;
                    h = canvas.height = window.innerHeight;
                    var count = Math.min(90, Math.floor((w * h) / 16000));
                    particles = [];
                    for (var i = 0; i < count; i++) {
                        particles.push({
                            x: Math.random() * w, y: Math.random() * h,
                            vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4,
                            r: Math.random() * 1.8 + 0.6, c: COLORS[Math.floor(Math.random() * COLORS.length)]
                        });
                    }
                }
                function draw() {
                    ctx.clearRect(0, 0, w, h);
                    for (var i = 0; i < particles.length; i++) {
                        var p = particles[i];
                        p.x += p.vx; p.y += p.vy;
                        if (p.x < 0 || p.x > w) p.vx *= -1;
                        if (p.y < 0 || p.y > h) p.vy *= -1;
                        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                        ctx.fillStyle = 'rgba(' + p.c + ',0.8)'; ctx.fill();
                        for (var j = i + 1; j < particles.length; j++) {
                            var q = particles[j];
                            var dx = p.x - q.x, dy = p.y - q.y, dist = Math.sqrt(dx * dx + dy * dy);
                            if (dist < 120) {
                                ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
                                ctx.strokeStyle = 'rgba(' + p.c + ',' + (0.12 * (1 - dist / 120)) + ')';
                                ctx.lineWidth = 0.6; ctx.stroke();
                            }
                        }
                    }
                    requestAnimationFrame(draw);
                }
                resize(); window.addEventListener('resize', resize); draw();
            } catch (e) { }
        })();
    </script>

    <script>
            let progIdActual = null;
            let cronoTimer = null;

            function ahoraStr() {
                const d = new Date(), p = n => String(n).padStart(2, '0');
                return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
            }

            function tomarUbicacion() {
                return new Promise((resolve, reject) => {
                    if (!navigator.geolocation) { reject('Este navegador no soporta geolocalización.'); return; }
                    navigator.geolocation.getCurrentPosition(
                        pos => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
                        err => reject('No se pudo obtener la ubicación (' + err.message + '). Verifique permisos y HTTPS.'),
                        { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
                    );
                });
            }

            function iniciarCronoModal(horaInicioStr) {
                const t0 = new Date(horaInicioStr.replace(' ', 'T')).getTime();
                const el = document.getElementById('cronoModal');
                function tick() {
                    const s = Math.max(0, Math.floor((Date.now() - t0) / 1000));
                    const h = String(Math.floor(s / 3600)).padStart(2, '0');
                    const m = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
                    const ss = String(s % 60).padStart(2, '0');
                    el.textContent = h + ':' + m + ':' + ss;
                }
                tick();
                cronoTimer = setInterval(tick, 1000);
            }

            async function iniciarCirugia(id) {
                progIdActual = id;
                try {
                    const u = await tomarUbicacion();
                    const t = ahoraStr();
                    localStorage.setItem('acto_prog_' + id, JSON.stringify({ lat: u.lat, lng: u.lng, horaInicio: t }));
                    document.getElementById('modalDoc').style.display = 'flex';
                    iniciarCronoModal(t);
                } catch (e) {
                    alert('No se pudo obtener la ubicación de inicio.\n' + e);
                }
            }

            function cerrarModalDoc() {
                const modal = document.getElementById('modalDoc');
                if (modal) modal.style.display = 'none';
                if (cronoTimer) { clearInterval(cronoTimer); cronoTimer = null; }
            }

            function abrirHojaGasto() {
                if (progIdActual == null) return;
                window.location.href = '/HojasGasto/Crear?progId=' + progIdActual;
            }

            function abrirTarjetaImplante() {
                if (progIdActual == null) return;
                window.location.href = '/TarjetasImplante/Crear?progId=' + progIdActual;
            }
    </script>
</body>
</html> 