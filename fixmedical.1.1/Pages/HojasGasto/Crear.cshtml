@page
@model fixmedical._1._1.Pages.HojasGasto.CrearModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <!-- ← MÓVIL: sin user-scalable=no → se permite pellizcar -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- ← FAVICON: el logo en la pestaña del navegador -->
    <link rel="icon" type="image/png" href="~/images/LOGO FIX CORTO_sin_fondo (1).png" />
    <title>Consumo Quirúrgico - FixMedical</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #dcdcdc;
                font-family: 'Calibri', sans-serif;
                padding: 20px;
                overflow-x: hidden;
            }

            .hoja-container {
                background: white;
                width: 34.5cm;
                height: 27.4cm;
                margin: 20px auto;
                padding: 2cm 1.5cm 1cm 1.5cm;
                border: none;
                box-shadow: 5px 5px 15px rgba(0,0,0,0.3);
                box-sizing: border-box;
                transform-origin: top center;
                position: relative;
                font-family: 'Calibri', sans-serif;
            }

            @@media screen and (max-width: 1200px) {
                .hoja-container {
                    transform: scale(0.7);
                }
            }

            @@media screen and (max-width: 900px) {
                .hoja-container {
                    transform: scale(0.55);
                }
            }

            @@media screen and (max-width: 600px) {
                .hoja-container {
                    transform: scale(0.4);
                }
            }

            .btn-flotantes {
                position: fixed;
                top: 20px;
                left: 20px;
                z-index: 1000;
            }

            .btn-circular {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                border: 2px solid #808080;
                background-color: #a9a9a9;
                color: white;
                font-size: 9px;
                font-weight: bold;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 4px;
                transition: all 0.3s ease;
                box-shadow: 2px 2px 8px rgba(0,0,0,0.3);
                text-decoration: none;
                font-family: 'Calibri', sans-serif;
                line-height: 1.1;
            }

                .btn-circular:hover {
                    background-color: #D8BFD8;
                    border-color: #D8BFD8;
                    color: #4a4a4a;
                    transform: scale(1.05);
                }

            .barra-acto {
                position: fixed;
                top: 20px;
                left: 50%;
                transform: translateX(-50%);
                z-index: 150000;
                background: #c62828;
                color: #fff;
                padding: 8px 20px;
                border-radius: 30px;
                font-weight: bold;
                font-size: 13px;
                box-shadow: 0 4px 14px rgba(0,0,0,0.3);
                display: none;
                align-items: center;
                gap: 9px;
                font-family: 'Calibri', sans-serif;
                letter-spacing: .3px;
            }

            .ba-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #fff;
                animation: parpadeo 1s infinite;
            }

            @@keyframes parpadeo {
                0%, 100% {
                    opacity: 1;
                }

                50% {
                    opacity: .25;
                }
            }

            .header-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 10px;
                padding-bottom: 0;
                border-bottom: none;
            }

            .logo-section img {
                max-width: 240px;
                height: auto;
            }

            .title-section {
                text-align: center;
                flex: 1;
                font-weight: bold;
                font-size: 19px;
                text-transform: uppercase;
                padding-left: 0;
                padding-right: 4cm;
                font-family: 'Calibri', sans-serif;
            }

            .id-section {
                font-size: 20px;
                font-weight: bold;
                color: #c00;
                font-family: 'Calibri', sans-serif;
            }

            .campo-row {
                display: flex;
                margin-bottom: 5px;
                align-items: baseline;
            }

            .campo-label {
                font-weight: bold;
                font-size: 12px;
                margin-right: 5px;
                white-space: nowrap;
                font-family: 'Calibri', sans-serif;
            }

            .input-line {
                border: none;
                border-bottom: 1px solid #000;
                flex: 1;
                outline: none;
                background: transparent;
                font-size: 12px;
                padding: 2px 5px;
                font-family: 'Calibri', sans-serif;
                font-weight: normal;
                text-transform: uppercase;
            }

            .linea-section {
                margin: 5px 0;
                padding: 0;
                border: none;
                border-radius: 0;
                display: flex;
                align-items: baseline;
                gap: 10px;
            }

            .linea-label {
                font-weight: bold;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
                white-space: nowrap;
            }

            .linea-opciones-inline {
                display: flex;
                gap: 15px;
                flex: 1;
                align-items: baseline;
                flex-wrap: wrap;
            }

            .linea-item-inline {
                display: flex;
                align-items: baseline;
                gap: 3px;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
                font-weight: bold;
                white-space: nowrap;
            }

            .linea-input-largo {
                border: none;
                border-bottom: 1px solid #000;
                width: 50px;
                text-align: center;
                font-size: 11px;
                font-weight: bold;
                outline: none;
                background: transparent;
                font-family: 'Calibri', sans-serif;
                text-transform: uppercase;
            }

            .tabla-formato {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0;
                border: 2px solid #000;
                border-radius: 10px;
                overflow: hidden;
                margin: 5px 0;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
            }

                .tabla-formato th {
                    background-color: #ffffff;
                    border: 1px solid #000;
                    padding: 6px 4px;
                    text-align: center;
                    font-weight: bold;
                    font-size: 10px;
                    text-transform: uppercase;
                    font-family: 'Calibri', sans-serif;
                }

                .tabla-formato td {
                    border: 1px solid #000;
                    padding: 0;
                    height: 26px;
                    font-family: 'Calibri', sans-serif;
                }

                    .tabla-formato th:first-child, .tabla-formato td:first-child {
                        border-left: none;
                    }

                    .tabla-formato th:last-child, .tabla-formato td:last-child {
                        border-right: none;
                    }

                .tabla-formato thead tr:first-child th {
                    border-top: none;
                }

                .tabla-formato tbody tr:last-child td {
                    border-bottom: none;
                }

            .input-cell {
                border: none;
                width: 100%;
                height: 100%;
                outline: none;
                padding: 3px 5px;
                font-size: 11px;
                background: transparent;
                font-family: 'Calibri', sans-serif;
                text-transform: uppercase;
            }

            .tabla-formato td:nth-child(1) .input-cell {
                text-align: center;
            }

            .tabla-formato td:nth-child(2) .input-cell {
                text-align: center;
            }

            .tabla-formato td:nth-child(3) .input-cell {
                text-align: left;
            }

            .tabla-formato td:nth-child(4) .input-cell {
                text-align: center;
            }

            .tabla-formato td:nth-child(5) .input-cell {
                text-align: center;
            }

            .tabla-formato td:nth-child(6) .input-cell {
                text-align: center;
            }

            .bottom-section {
                margin-top: 8px;
                margin-bottom: 8px;
                display: flex;
                justify-content: space-between;
                align-items: baseline;
            }

            .fabricante-box {
                flex: 1;
                margin-right: 20px;
            }

            .domicilio-box {
                flex: 1;
            }

            .domicilio-section {
                display: flex;
                align-items: baseline;
                gap: 10px;
                margin-top: 5px;
            }

            .domicilio-label {
                font-weight: bold;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
                white-space: nowrap;
            }

            .pais-opciones-inline {
                display: flex;
                gap: 15px;
                align-items: baseline;
                flex-wrap: wrap;
            }

            .pais-item-inline {
                display: flex;
                align-items: baseline;
                gap: 3px;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
                font-weight: bold;
                white-space: nowrap;
            }

            .pais-input-largo {
                border: none;
                border-bottom: 1px solid #000;
                width: 40px;
                text-align: center;
                font-size: 11px;
                font-weight: bold;
                outline: none;
                background: transparent;
                font-family: 'Calibri', sans-serif;
                text-transform: uppercase;
            }

            .firmas-section {
                display: flex;
                justify-content: space-between;
                margin-top: 8px;
                margin-bottom: 8px;
                gap: 15px;
            }

            .firma-box {
                flex: 1;
                text-align: center;
            }

            .canvas-firma {
                border: none;
                background-color: transparent;
                width: 100%;
                height: 55px;
                display: block;
                margin: 0 auto 3px;
                touch-action: none;
                cursor: crosshair;
            }

            .firma-label {
                font-size: 9px;
                font-weight: bold;
                text-align: center;
                margin-top: 2px;
                border-top: 1px solid #000;
                padding-top: 2px;
                font-family: 'Calibri', sans-serif;
            }

            .footer-final {
                margin-top: 8px;
                margin-bottom: 8px;
                display: flex;
                gap: 20px;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
            }

            .footer-item {
                flex: 1;
                display: flex;
                align-items: baseline;
            }

            .footer-label {
                font-weight: bold;
                margin-right: 5px;
                white-space: nowrap;
                font-family: 'Calibri', sans-serif;
            }

            .footer-input {
                border: none;
                border-bottom: 1px solid #000;
                flex: 1;
                outline: none;
                background: transparent;
                font-size: 11px;
                font-family: 'Calibri', sans-serif;
                text-transform: uppercase;
            }

            .sugerencias-dropdown {
                position: fixed;
                z-index: 100000;
                background: #ffffff;
                border: 1px solid #999;
                border-radius: 5px;
                max-height: 230px;
                overflow-y: auto;
                box-shadow: 0 5px 15px rgba(0,0,0,0.25);
                display: none;
                font-family: 'Calibri', sans-serif;
            }

            .sugerencias-item {
                padding: 6px 10px;
                cursor: pointer;
                font-size: 11px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid #eee;
            }

                .sugerencias-item:last-child {
                    border-bottom: none;
                }

                .sugerencias-item:hover, .sugerencias-item.active {
                    background-color: #D8BFD8;
                }

            .sugerencias-ref {
                font-weight: bold;
                white-space: nowrap;
            }

            .sugerencias-desc {
                color: #555;
                font-size: 10px;
                max-width: 320px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                text-align: right;
            }

            .sugerencias-vacio {
                padding: 6px 10px;
                font-size: 10px;
                color: #888;
                font-style: italic;
            }

            .modal-acciones {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.55);
                z-index: 200000;
                display: none;
                align-items: center;
                justify-content: center;
                font-family: 'Calibri', sans-serif;
            }

            .modal-box {
                background: #fff;
                border-radius: 14px;
                padding: 25px 30px;
                width: 440px;
                max-width: 92%;
                box-shadow: 0 10px 40px rgba(0,0,0,0.4);
                position: relative;
            }

                .modal-box h3 {
                    margin: 0 0 18px 0;
                    font-size: 18px;
                    text-transform: uppercase;
                    color: #333;
                    text-align: center;
                }

            .modal-close {
                position: absolute;
                top: 8px;
                right: 12px;
                border: none;
                background: transparent;
                font-size: 24px;
                cursor: pointer;
                color: #888;
                line-height: 1;
            }

                .modal-close:hover {
                    color: #c00;
                }

            .modal-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .accion-btn {
                border: none;
                border-radius: 10px;
                padding: 14px 10px;
                font-size: 13px;
                font-weight: bold;
                cursor: pointer;
                color: #fff;
                font-family: 'Calibri', sans-serif;
                transition: transform 0.15s ease, filter 0.15s ease;
            }

                .accion-btn:hover {
                    transform: translateY(-2px);
                    filter: brightness(1.08);
                }

                .accion-btn.guardar {
                    background: #2e7d32;
                    grid-column: 1 / -1;
                    font-size: 15px;
                }

                .accion-btn.pdf {
                    background: #1565c0;
                }

                .accion-btn.correo {
                    background: #6a1b9a;
                }

            /* ===== MODO PDF CARTA HORIZONTAL ===== */
            .hoja-container.pdf-compact {
                width: 27.3cm !important;
                height: 20.8cm !important;
                padding: 0.4cm 0.5cm !important;
                margin: 0 !important;
                box-shadow: none !important;
                transform: none !important;
                display: flex !important;
                flex-direction: column !important;
            }

                .hoja-container.pdf-compact > form {
                    display: flex !important;
                    flex-direction: column !important;
                    height: 100% !important;
                    width: 100% !important;
                }

                .hoja-container.pdf-compact .header-top {
                    margin-bottom: 4px !important;
                    flex: 0 0 auto !important;
                }

                .hoja-container.pdf-compact .logo-section img {
                    max-width: 150px !important;
                }

                .hoja-container.pdf-compact .title-section {
                    font-size: 15px !important;
                    padding-right: 2.5cm !important;
                }

                .hoja-container.pdf-compact .id-section {
                    font-size: 16px !important;
                }

                .hoja-container.pdf-compact .campo-row {
                    margin-bottom: 3px !important;
                    flex: 0 0 auto !important;
                }

                .hoja-container.pdf-compact .campo-label {
                    font-size: 11px !important;
                }

                .hoja-container.pdf-compact .input-line {
                    font-size: 11px !important;
                }

                .hoja-container.pdf-compact .linea-section {
                    margin: 3px 0 !important;
                    flex: 0 0 auto !important;
                }

                .hoja-container.pdf-compact .linea-label, .hoja-container.pdf-compact .linea-item-inline {
                    font-size: 10px !important;
                }

                .hoja-container.pdf-compact .linea-input-largo {
                    width: 32px !important;
                    font-size: 10px !important;
                }

                .hoja-container.pdf-compact .tabla-formato {
                    flex: 1 1 auto !important;
                    min-height: 0 !important;
                    margin: 3px 0 !important;
                }

                    .hoja-container.pdf-compact .tabla-formato th {
                        padding: 3px 2px !important;
                        font-size: 9px !important;
                    }

                    .hoja-container.pdf-compact .tabla-formato td {
                        height: auto !important;
                    }

                .hoja-container.pdf-compact .input-cell {
                    padding: 1px 3px !important;
                    font-size: 9px !important;
                }

                .hoja-container.pdf-compact .bottom-section {
                    margin-top: 4px !important;
                    margin-bottom: 4px !important;
                    flex: 0 0 auto !important;
                }

                .hoja-container.pdf-compact .domicilio-label, .hoja-container.pdf-compact .pais-item-inline {
                    font-size: 10px !important;
                }

                .hoja-container.pdf-compact .pais-input-largo {
                    width: 28px !important;
                    font-size: 10px !important;
                }

                .hoja-container.pdf-compact .firmas-section {
                    margin-top: 4px !important;
                    margin-bottom: 4px !important;
                    gap: 10px !important;
                    flex: 0 0 auto !important;
                }

                .hoja-container.pdf-compact .canvas-firma {
                    height: 42px !important;
                    margin: 0 auto 1px !important;
                }

                .hoja-container.pdf-compact .firma-label {
                    font-size: 8px !important;
                    margin-top: 1px !important;
                    padding-top: 1px !important;
                }

                .hoja-container.pdf-compact .footer-final {
                    margin-top: 3px !important;
                    margin-bottom: 0 !important;
                    gap: 10px !important;
                    flex: 0 0 auto !important;
                }

                .hoja-container.pdf-compact .footer-label, .hoja-container.pdf-compact .footer-input {
                    font-size: 10px !important;
                }

            .pdf-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.6);
                z-index: 99999;
                display: none;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 22px;
                font-family: 'Calibri', sans-serif;
                font-weight: bold;
            }

            @@media print {
                body {
                    background-color: white;
                    padding: 0;
                }

                .no-print, .btn-flotantes, .barra-acto {
                    display: none !important;
                }

                .hoja-container {
                    margin: 0;
                    border: none;
                    box-shadow: none;
                    transform: none !important;
                    width: 34.5cm;
                    height: 27.4cm;
                    padding: 2cm 1cm 1cm 1cm;
                }
            }

            /* ===== MÓVIL (≤700px): formulario táctil apilado; la TABLA se desliza con el dedo ===== */
            @@media screen and (max-width: 700px) {
                body {
                    padding: 8px;
                }

                .hoja-container {
                    width: 100%;
                    height: auto;
                    margin: 8px auto;
                    padding: 12px;
                    transform: none !important;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
                }
                /* header apilado */
                .header-top {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 8px;
                }

                .logo-section img {
                    max-width: 180px;
                }

                .title-section {
                    text-align: left;
                    padding-right: 0;
                    font-size: 16px;
                    width: 100%;
                }

                .id-section {
                    align-self: flex-end;
                    font-size: 16px;
                }
                /* campos en columna */
                .campo-row {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 4px;
                    margin-bottom: 10px;
                }

                .campo-label {
                    margin-right: 0;
                    margin-top: 6px;
                }

                    .campo-label[style] {
                        margin-left: 0 !important;
                    }

                .input-line {
                    font-size: 16px;
                    min-height: 44px;
                    padding: 8px 5px;
                }
                    /* anula el "flex: 0 0 120px" inline, que en columna daría 120px de ALTO */
                    .input-line[style] {
                        flex: 1 !important;
                    }
                /* LÍNEA y PAÍS en columna */
                .linea-section, .domicilio-section {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 6px;
                }

                .linea-opciones-inline, .pais-opciones-inline {
                    flex-direction: column;
                    gap: 8px;
                }

                .linea-item-inline, .pais-item-inline {
                    font-size: 14px;
                }

                .linea-input-largo, .pais-input-largo {
                    width: 100%;
                    min-height: 44px;
                    font-size: 16px;
                    text-align: left;
                    padding: 8px;
                }
                /* tabla: tabla REAL con scroll horizontal (desliza con el dedo) */
                .tabla-scroll {
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }

                .tabla-formato {
                    min-width: 640px;
                }

                .input-cell {
                    font-size: 14px;
                    min-height: 36px;
                }
                /* fabricante / domicilio apilados */
                .bottom-section {
                    flex-direction: column;
                    gap: 10px;
                }

                .fabricante-box, .domicilio-box {
                    margin-right: 0;
                    width: 100%;
                }
                /* firmas en columna, altas para dedo */
                .firmas-section {
                    flex-direction: column;
                    gap: 12px;
                }

                .firma-box {
                    width: 100%;
                }

                .canvas-firma {
                    height: 120px;
                }

                .firma-label {
                    font-size: 12px;
                }
                /* footer apilado */
                .footer-final {
                    flex-direction: column;
                    gap: 8px;
                }

                .footer-item {
                    width: 100%;
                }

                .footer-input {
                    font-size: 16px;
                    min-height: 44px;
                }
                /* botón a la zona del pulgar */
                .btn-flotantes {
                    top: auto;
                    left: auto;
                    right: 16px;
                    bottom: 16px;
                }

                .barra-acto {
                    font-size: 11px;
                    padding: 6px 12px;
                    max-width: 92vw;
                    top: 12px;
                }

                .modal-grid {
                    grid-template-columns: 1fr;
                }

                .sugerencias-dropdown {
                    max-width: 94vw;
                }
            }

            /* ===== GUARDAS PDF: si el PDF se genera desde el celular, vuelve al layout de escritorio ===== */
            .hoja-container.pdf-compact .header-top {
                flex-direction: row !important;
                align-items: center !important;
            }

            .hoja-container.pdf-compact .title-section {
                text-align: center !important;
            }

            .hoja-container.pdf-compact .id-section {
                align-self: center !important;
            }

            .hoja-container.pdf-compact .campo-row {
                flex-direction: row !important;
                align-items: baseline !important;
            }

            .hoja-container.pdf-compact .campo-label {
                margin-top: 0 !important;
            }

                .hoja-container.pdf-compact .campo-label[style] {
                    margin-left: 20px !important;
                }

            .hoja-container.pdf-compact .input-line {
                min-height: 0 !important;
                padding: 2px 5px !important;
            }

                .hoja-container.pdf-compact .input-line[style] {
                    flex: 0 0 120px !important;
                }

            .hoja-container.pdf-compact .linea-section,
            .hoja-container.pdf-compact .domicilio-section {
                flex-direction: row !important;
            }

            .hoja-container.pdf-compact .linea-opciones-inline,
            .hoja-container.pdf-compact .pais-opciones-inline {
                flex-direction: row !important;
            }

            .hoja-container.pdf-compact .linea-input-largo,
            .hoja-container.pdf-compact .pais-input-largo {
                width: 32px !important;
                min-height: 0 !important;
                text-align: center !important;
                padding: 0 !important;
            }

            .hoja-container.pdf-compact .tabla-scroll {
                overflow: visible !important;
            }

            .hoja-container.pdf-compact .tabla-formato {
                min-width: 0 !important;
            }

            .hoja-container.pdf-compact .input-cell {
                min-height: 0 !important;
            }

            .hoja-container.pdf-compact .bottom-section {
                flex-direction: row !important;
            }

            .hoja-container.pdf-compact .fabricante-box {
                margin-right: 20px !important;
            }

            .hoja-container.pdf-compact .firmas-section {
                flex-direction: row !important;
            }

            .hoja-container.pdf-compact .footer-final {
                flex-direction: row !important;
            }

            .hoja-container.pdf-compact .footer-input {
                min-height: 0 !important;
            }
    </style>
</head>
<body>

    <div class="btn-flotantes no-print">
        <button type="button" class="btn-circular" onclick="abrirModal()" title="Opciones">OPCIONES</button>
    </div>

    <div id="barraActo" class="barra-acto no-print">
        <span class="ba-dot"></span> CIRUGÍA EN CURSO — <span id="cronometro">00:00:00</span>
    </div>

    <div class="hoja-container" id="hojaOriginal">
        <form method="post" id="formHoja" enctype="multipart/form-data">
            <div asp-validation-summary="All" style="color:red; font-weight:bold; margin-bottom:10px;"></div>

            <div class="header-top">
                <div class="logo-section"><img src="~/images/LOGO FIX1_sin_fondo.png" alt="FixMedical" /></div>
                <div class="title-section">CONSUMO QUIRURGICO (TARJETA DE PRODUCTO)</div>
                <div class="id-section">@Model.ConsecutivoGenerado</div>
            </div>

            <div class="campo-row">
                <span class="campo-label">INSTITUCIÓN:</span>
                <input asp-for="NuevaHoja.Institucion" class="input-line" />
                <span class="campo-label" style="margin-left: 20px;">FECHA:</span>
                <input type="date" asp-for="NuevaHoja.Fecha" class="input-line" style="flex: 0 0 120px;" />
                <span class="campo-label" style="margin-left: 20px;">REMISIÓN:</span>
                <input asp-for="NuevaHoja.Remision" class="input-line" style="flex: 0 0 100px;" />
            </div>

            <div class="campo-row">
                <span class="campo-label">ESPECIALISTA:</span>
                <input asp-for="NuevaHoja.Especialista" class="input-line" />
                <span class="campo-label" style="margin-left: 20px;">PACIENTE:</span>
                <input asp-for="NuevaHoja.Paciente" class="input-line" />
                <span class="campo-label" style="margin-left: 20px;">ID:</span>
                <input asp-for="NuevaHoja.PacienteID" class="input-line" style="flex: 0 0 120px;" />
            </div>

            <div class="linea-section">
                <span class="linea-label">LÍNEA:</span>
                <div class="linea-opciones-inline">
                    <span class="linea-item-inline">FIXCMF <input type="text" class="linea-input-largo" name="Linea_FIXCMF" maxlength="1" /></span>
                    <span class="linea-item-inline">BONEFIX <input type="text" class="linea-input-largo" name="Linea_BONEFIX" maxlength="1" /></span>
                    <span class="linea-item-inline">FIXPIEZO <input type="text" class="linea-input-largo" name="Linea_FIXPIEZO" maxlength="1" /></span>
                    <span class="linea-item-inline">FIXPECTUS <input type="text" class="linea-input-largo" name="Linea_FIXPECTUS" maxlength="1" /></span>
                    <span class="linea-item-inline">FIXTORAX <input type="text" class="linea-input-largo" name="Linea_FIXTORAX" maxlength="1" /></span>
                    <span class="linea-item-inline">FIXANCLAS <input type="text" class="linea-input-largo" name="Linea_FIXANCLAS" maxlength="1" /></span>
                    <span class="linea-item-inline">FIXHAND <input type="text" class="linea-input-largo" name="Linea_FIXHAND" maxlength="1" /></span>
                </div>
            </div>

            <!-- ← MÓVIL: este div hace la tabla deslizable; en PC no estorba -->
            <div class="tabla-scroll">
                <table class="tabla-formato">
                    <colgroup>
                        <col style="width: 14%;">
                        <col style="width: 17%;">
                        <col style="width: 32%;">
                        <col style="width: 8%;">
                        <col style="width: 12%;">
                        <col style="width: 17%;">
                    </colgroup>
                    <thead>
                        <tr><th>CODIGO</th><th>REFERENCIA</th><th>DESCRIPCIÓN</th><th>CANT.</th><th>LOTE</th><th>REG. INVIMA</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 20; i++)
                        {
                            <tr>
                                <td><input type="text" class="input-cell" name="Codigos[]" readonly /></td>
                                <td><input type="text" class="input-cell" name="Referencias[]" onkeydown="manejarEnter(event, this)" onblur="buscarProducto(this)" autocomplete="off" /></td>
                                <td><input type="text" class="input-cell" name="Descripciones[]" readonly /></td>
                                <td><input type="text" class="input-cell" name="Cantidades[]" /></td>
                                <td><input type="text" class="input-cell" name="Lotes[]" /></td>
                                <td><input type="text" class="input-cell" name="Invimas[]" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bottom-section">
                <div class="fabricante-box">
                    <div class="campo-row">
                        <span class="campo-label">FABRICANTE:</span>
                        <input type="text" class="input-line" name="Fabricante" />
                    </div>
                </div>
                <div class="domicilio-box">
                    <div class="domicilio-section">
                        <span class="domicilio-label">DOMICILIO PAÍS:</span>
                        <div class="pais-opciones-inline">
                            <span class="pais-item-inline">CH <input type="text" class="pais-input-largo" name="Pais_CH" maxlength="1" /></span>
                            <span class="pais-item-inline">IT <input type="text" class="pais-input-largo" name="Pais_IT" maxlength="1" /></span>
                            <span class="pais-item-inline">AL <input type="text" class="pais-input-largo" name="Pais_AL" maxlength="1" /></span>
                            <span class="pais-item-inline">USA <input type="text" class="pais-input-largo" name="Pais_USA" maxlength="1" /></span>
                            <span class="pais-item-inline">BRA <input type="text" class="pais-input-largo" name="Pais_BRA" maxlength="1" /></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="firmas-section">
                <div class="firma-box">
                    <canvas id="canvasEsp" class="canvas-firma"></canvas>
                    <div class="firma-label">FIRMA ESPECIALISTA</div>
                    <input type="hidden" name="FirmaEspBase64" id="FirmaEspBase64" />
                </div>
                <div class="firma-box">
                    <canvas id="canvasInst" class="canvas-firma"></canvas>
                    <div class="firma-label">FIRMA IQX INSTITUCIÓN</div>
                    <input type="hidden" name="FirmaInstBase64" id="FirmaInstBase64" />
                </div>
                <div class="firma-box">
                    <canvas id="canvasFix" class="canvas-firma"></canvas>
                    <div class="firma-label">FIRMA IQX FIXMEDICAL</div>
                    <input type="hidden" name="FirmaFixBase64" id="FirmaFixBase64" />
                </div>
            </div>

            <div class="footer-final">
                <div class="footer-item"><span class="footer-label">FACTURAR A:</span><input type="text" class="footer-input" name="FacturarA" /></div>
                <div class="footer-item"><span class="footer-label">PEDIDO:</span><input type="text" class="footer-input" name="Pedido" /></div>
                <div class="footer-item"><span class="footer-label">DESPACHO:</span><input type="text" class="footer-input" name="Despacho" /></div>
            </div>

            <!-- ===== HIDDEN DE UBICACIÓN + DURACIÓN + PDF + PROGID ===== -->
            <input type="hidden" name="LatInicioStr" id="LatitudInicio" />
            <input type="hidden" name="LngInicioStr" id="LongitudInicio" />
            <input type="hidden" name="FhInicioStr" id="FechaHoraInicio" />
            <input type="hidden" name="LatFinStr" id="LatitudFin" />
            <input type="hidden" name="LngFinStr" id="LongitudFin" />
            <input type="hidden" name="FhFinStr" id="FechaHoraFin" />
            <input type="hidden" name="NuevaHoja.DuracionSegundos" id="DuracionSegundos" />
            <input type="hidden" name="PdfBase64" id="PdfBase64" />
            <input type="hidden" name="progIdHidden" value="@Model.ProgIdActual" />
        </form>
    </div>

    <!-- ===== MODAL ===== -->
    <div id="modalAcciones" class="modal-acciones">
        <div class="modal-box">
            <button type="button" class="modal-close" onclick="cerrarModal()">&times;</button>
            <h3>Acciones de la tarjeta</h3>
            <div class="modal-grid">
                <button type="submit" form="formHoja" class="accion-btn guardar">💾 GUARDAR TARJETA</button>
                <button type="button" class="accion-btn pdf" onclick="descargarPDF()">📄 DESCARGAR PDF</button>
                <button type="button" class="accion-btn correo" onclick="enviarCorreo()">✉️ ENVIAR CORREO</button>
            </div>
        </div>
    </div>

    <div id="sugerenciasDropdown" class="sugerencias-dropdown"></div>

    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
            const canvasEsp = document.getElementById('canvasEsp');
            const canvasInst = document.getElementById('canvasInst');
            const canvasFix = document.getElementById('canvasFix');

            function ajustarCanvas(c) {
                const rect = c.getBoundingClientRect();
                c.width = rect.width * window.devicePixelRatio;
                c.height = rect.height * window.devicePixelRatio;
                c.style.width = rect.width + 'px';
                c.style.height = rect.height + 'px';
                const ctx = c.getContext('2d');
                ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
            }
            window.addEventListener('load', () => { [canvasEsp, canvasInst, canvasFix].forEach(c => ajustarCanvas(c)); });

            const padEsp = new SignaturePad(canvasEsp);
            const padInst = new SignaturePad(canvasInst);
            const padFix = new SignaturePad(canvasFix);

            function setFirmas() {
                document.getElementById('FirmaEspBase64').value = padEsp.isEmpty() ? '' : padEsp.toDataURL('image/png');
                document.getElementById('FirmaInstBase64').value = padInst.isEmpty() ? '' : padInst.toDataURL('image/png');
                document.getElementById('FirmaFixBase64').value = padFix.isEmpty() ? '' : padFix.toDataURL('image/png');
            }

            /* ============ MODAL ============ */
            function abrirModal() { document.getElementById('modalAcciones').style.display = 'flex'; }
            function cerrarModal() { document.getElementById('modalAcciones').style.display = 'none'; }
            document.getElementById('modalAcciones').addEventListener('mousedown', function(e) { if (e.target === this) cerrarModal(); });

            /* ============ OVERLAY ============ */
            function showOverlay(msg) {
                let o = document.getElementById('pdfOverlay');
                if (!o) { o = document.createElement('div'); o.id = 'pdfOverlay'; o.className = 'pdf-overlay'; document.body.appendChild(o); }
                o.textContent = msg; o.style.display = 'flex';
            }
            function hideOverlay() { const o = document.getElementById('pdfOverlay'); if (o) o.style.display = 'none'; }

            /* ============ ACTO EN CURSO ============ */
            function getProgId() { return new URLSearchParams(location.search).get('progId'); }
            function getActo() {
                const id = getProgId();
                if (!id) return null;
                try { const s = localStorage.getItem('acto_prog_' + id); return s ? JSON.parse(s) : null; }
                catch (e) { return null; }
            }
            function ahoraStr() {
                const d = new Date(), p = n => String(n).padStart(2, '0');
                return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
            }
            function tomarUbicacion() {
                return new Promise((resolve, reject) => {
                    if (!navigator.geolocation) { reject('Este navegador no soporta geolocalización.'); return; }
                    navigator.geolocation.getCurrentPosition(
                        pos => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
                        err => reject('No se pudo obtener la ubicación (' + err.message + '). Verifique permisos y HTTPS.'),
                        { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
                    );
                });
            }
            let cronTimer = null;
            function iniciarCronometro(horaInicioStr) {
                const t0 = new Date(horaInicioStr.replace(' ', 'T')).getTime();
                const el = document.getElementById('cronometro');
                function tick() {
                    const s = Math.max(0, Math.floor((Date.now() - t0) / 1000));
                    const h = String(Math.floor(s / 3600)).padStart(2, '0');
                    const m = String.floor((s % 3600) / 60).toString().padStart(2, '0');
                    const ss = String(s % 60).padStart(2, '0');
                    el.textContent = h + ':' + m + ':' + ss;
                }
                tick(); cronTimer = setInterval(tick, 1000);
            }
            window.addEventListener('load', () => {
                const acto = getActo();
                if (acto && acto.horaInicio) {
                    document.getElementById('barraActo').style.display = 'flex';
                    document.getElementById('LatitudInicio').value = acto.lat != null ? acto.lat : '';
                    document.getElementById('LongitudInicio').value = acto.lng != null ? acto.lng : '';
                    document.getElementById('FechaHoraInicio').value = acto.horaInicio || '';
                    iniciarCronometro(acto.horaInicio);
                }
            });

            /* ============ AUTOCOMPLETADO (con REG. INVIMA) ============ */
            const dropdown = document.getElementById('sugerenciasDropdown');
            let inputActivo = null, indiceActivo = -1, sugerenciasActuales = [], debounceTimer = null;
            function dropdownVisible() { return dropdown.style.display === 'block'; }
            function mostrarDropdown() { dropdown.style.display = 'block'; }
            function ocultarDropdown() { dropdown.style.display = 'none'; indiceActivo = -1; sugerenciasActuales = []; }
            function escapeHtml(s) { return (s || '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
            function posicionarDropdown(input) {
                const rect = input.getBoundingClientRect();
                dropdown.style.top = (rect.bottom + 2) + 'px';
                dropdown.style.left = rect.left + 'px';
                dropdown.style.width = Math.max(rect.width, 440) + 'px';
            }
            function pedirSugerencias(input) {
                const texto = input.value.trim();
                inputActivo = input;
                if (texto.length < 1) { ocultarDropdown(); return; }
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    fetch('?handler=BuscarReferencias&texto=' + encodeURIComponent(texto))
                        .then(r => r.json())
                        .then(data => {
                            if (input !== inputActivo) return;
                            if (!data || data.length === 0) {
                                sugerenciasActuales = [];
                                dropdown.innerHTML = '<div class="sugerencias-vacio">Sin coincidencias</div>';
                                posicionarDropdown(input); mostrarDropdown(); return;
                            }
                            sugerenciasActuales = data; indiceActivo = -1;
                            renderSugerencias(); posicionarDropdown(input); mostrarDropdown();
                        }).catch(() => ocultarDropdown());
                }, 200);
            }
            function renderSugerencias() {
                dropdown.innerHTML = '';
                sugerenciasActuales.forEach((item, idx) => {
                    const div = document.createElement('div');
                    div.className = 'sugerencias-item' + (idx === indiceActivo ? ' active' : '');
                    div.innerHTML = '<span class="sugerencias-ref">' + escapeHtml(item.referencia) + '</span><span class="sugerencias-desc">' + escapeHtml(item.descripcion) + '</span>';
                    div.addEventListener('mousedown', function(e) { e.preventDefault(); aplicarSugerencia(idx); });
                    dropdown.appendChild(div);
                });
            }
            function actualizarActivo() {
                const items = dropdown.querySelectorAll('.sugerencias-item');
                items.forEach((it, i) => it.classList.toggle('active', i === indiceActivo));
                if (indiceActivo >= 0 && items[indiceActivo]) items[indiceActivo].scrollIntoView({ block: 'nearest' });
            }
            /* ← AQUÍ: ahora también llena REG. INVIMA */
            function aplicarSugerencia(idx) {
                if (!inputActivo || idx < 0 || idx >= sugerenciasActuales.length) return;
                const data = sugerenciasActuales[idx];
                const fila = inputActivo.closest('tr');
                inputActivo.value = (data.referencia || '').toUpperCase();
                if (fila) {
                    const cod = fila.querySelector('[name="Codigos[]"]');
                    const desc = fila.querySelector('[name="Descripciones[]"]');
                    const inv = fila.querySelector('[name="Invimas[]"]');
                    if (cod) cod.value = (data.codigo || '').toUpperCase();
                    if (desc) desc.value = (data.descripcion || '').toUpperCase();
                    if (inv) inv.value = (data.regInvima || '').toUpperCase();
                }
                ocultarDropdown();
                if (fila) saltarASiguienteFila(fila);
            }
            document.querySelectorAll('input[name="Referencias[]"]').forEach(input => {
                input.addEventListener('input', () => pedirSugerencias(input));
                input.addEventListener('focus', () => { if (input.value.trim()) pedirSugerencias(input); });
                input.addEventListener('blur', () => { setTimeout(ocultarDropdown, 120); });
            });
            window.addEventListener('scroll', ocultarDropdown, true);
            document.addEventListener('mousedown', function(e) {
                if (!dropdown.contains(e.target) && e.target !== inputActivo) ocultarDropdown();
            });

            /* ============ PDF CARTA HORIZONTAL ============ */
            function getOpt() {
                return {
                    filename: 'Consumo_Quirurgico.pdf',
                    margin: [0.2, 0.2, 0.2, 0.2],
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true, logging: false, backgroundColor: '#ffffff' },
                    jsPDF: { unit: 'cm', format: 'letter', orientation: 'landscape', compress: true }
                };
            }

            async function prepararCompacto() {
                cerrarModal();
                ocultarDropdown();
                hideOverlay();
                const el = document.getElementById('hojaOriginal');
                el.classList.add('pdf-compact');
                void el.offsetHeight;
                await new Promise(r => setTimeout(r, 220));

                const tabla = el.querySelector('.tabla-formato');
                const thead = tabla.querySelector('thead');
                const filas = tabla.querySelectorAll('tbody tr');
                const tablaH = tabla.getBoundingClientRect().height;
                const theadH = thead.getBoundingClientRect().height;
                const filaH = Math.max(14, (tablaH - theadH) / filas.length);

                tabla.style.flex = 'none';
                tabla.style.height = tablaH + 'px';
                filas.forEach(tr => tr.querySelectorAll('td').forEach(td => { td.style.height = filaH + 'px'; }));
                void el.offsetHeight;
                return el;
            }

            function limpiarCompacto(el) {
                const tabla = el.querySelector('.tabla-formato');
                if (tabla) {
                    tabla.style.flex = '';
                    tabla.style.height = '';
                    tabla.querySelectorAll('tbody tr td').forEach(td => { td.style.height = ''; });
                }
                el.classList.remove('pdf-compact');
            }

            async function generarPdfDataUri() {
                const el = await prepararCompacto();
                try {
                    return (await html2pdf().set(getOpt()).from(el).outputPdf('datauristring')) || '';
                } finally {
                    limpiarCompacto(el);
                }
            }

            async function descargarPDF() {
                showOverlay('Generando PDF...');
                const el = await prepararCompacto();
                try {
                    await html2pdf().set(getOpt()).from(el).save();
                } catch (err) { console.error('Error generando PDF:', err); alert('Error al generar el PDF'); }
                finally { limpiarCompacto(el); hideOverlay(); }
            }

            /* ============ GUARDAR ============ */
            let enviando = false;
            document.getElementById('formHoja').addEventListener('submit', async function(e) {
                if (enviando) { e.preventDefault(); return; }
                setFirmas();

                const btnGuardar = document.querySelector('.accion-btn.guardar');
                const acto = getActo();

                if (acto && acto.horaInicio) {
                    e.preventDefault();
                    enviando = true;
                    if (btnGuardar) btnGuardar.disabled = true;
                    showOverlay('Guardando tarjeta y generando PDF...');
                    try {
                        try {
                            const u = await tomarUbicacion();
                            document.getElementById('LatitudFin').value = u.lat;
                            document.getElementById('LongitudFin').value = u.lng;
                            document.getElementById('FechaHoraFin').value = ahoraStr();
                            const t0 = new Date(acto.horaInicio.replace(' ', 'T')).getTime();
                            document.getElementById('DuracionSegundos').value = Math.max(0, Math.round((Date.now() - t0) / 1000));
                        } catch (geoErr) {
                            if (!confirm('No se pudo obtener la ubicación de FIN (' + geoErr + '). ¿Guardar sin ubicación de fin?')) {
                                enviando = false; if (btnGuardar) btnGuardar.disabled = false; hideOverlay(); return;
                            }
                        }
                        try { document.getElementById('PdfBase64').value = await generarPdfDataUri(); } catch (pdfErr) { console.error('PDF:', pdfErr); }
                        const id = getProgId(); if (id) localStorage.removeItem('acto_prog_' + id);
                        if (cronTimer) { clearInterval(cronTimer); cronTimer = null; }
                        hideOverlay();
                        this.submit();
                    } catch (err) {
                        enviando = false; if (btnGuardar) btnGuardar.disabled = false; hideOverlay(); alert('Error al guardar: ' + err);
                    }
                } else {
                    enviando = true;
                    if (btnGuardar) btnGuardar.disabled = true;
                    showOverlay('Guardando tarjeta...');
                }
            });

            /* ============ CORREO ============ */
            function enviarCorreo() {
                const f = document.getElementById('formHoja');
                const v = n => { const el = f.querySelector('[name="NuevaHoja.' + n + '"]'); return el ? (el.value || '') : ''; };
                const cons = (document.querySelector('.id-section') || {}).textContent || '';
                const asunto = 'Consumo Quirúrgico ' + cons.trim() + ' - Paciente ' + v('Paciente');
                const cuerpo =
                    'Institución: ' + v('Institucion') + '\n' +
                    'Especialista: ' + v('Especialista') + '\n' +
                    'Paciente: ' + v('Paciente') + ' (ID ' + v('PacienteID') + ')\n' +
                    'Remisión: ' + v('Remision') + '\n' +
                    'Consecutivo: ' + cons.trim() + '\n\n' +
                    'Se remite tarjeta de consumo quirúrgico.';
                window.location.href = 'mailto:?subject=' + encodeURIComponent(asunto) + '&body=' + encodeURIComponent(cuerpo);
            }

            /* ============ NAVEGACIÓN TABLA (con REG. INVIMA) ============ */
            function manejarEnter(event, input) {
                if (dropdownVisible()) {
                    if (event.key === 'ArrowDown') { event.preventDefault(); if (sugerenciasActuales.length) { indiceActivo = (indiceActivo + 1) % sugerenciasActuales.length; actualizarActivo(); } return; }
                    if (event.key === 'ArrowUp') { event.preventDefault(); if (sugerenciasActuales.length) { indiceActivo = (indiceActivo - 1 + sugerenciasActuales.length) % sugerenciasActuales.length; actualizarActivo(); } return; }
                    if (event.key === 'Escape') { event.preventDefault(); ocultarDropdown(); return; }
                    if (event.key === 'Enter') { event.preventDefault(); if (indiceActivo >= 0) aplicarSugerencia(indiceActivo); else if (sugerenciasActuales.length > 0) aplicarSugerencia(0); else ocultarDropdown(); return; }
                }
                if (event.key === 'Enter') {
                    event.preventDefault();
                    let ref = input.value.trim(), fila = input.closest('tr');
                    if (ref) {
                        fetch('?handler=BuscarProducto&referencia=' + encodeURIComponent(ref))
                            .then(res => res.json())
                            .then(data => {
                                if (data) {
                                    const cod = fila.querySelector('[name="Codigos[]"]');
                                    const desc = fila.querySelector('[name="Descripciones[]"]');
                                    const inv = fila.querySelector('[name="Invimas[]"]');
                                    if (cod) cod.value = (data.codigo || '').toUpperCase();
                                    if (desc) desc.value = (data.descripcion || '').toUpperCase();
                                    if (inv) inv.value = (data.regInvima || '').toUpperCase();
                                }
                                saltarASiguienteFila(fila);
                            }).catch(err => { console.error(err); saltarASiguienteFila(fila); });
                    } else { saltarASiguienteFila(fila); }
                }
            }
            function saltarASiguienteFila(filaActual) {
                const siguienteFila = filaActual.nextElementSibling;
                if (siguienteFila) {
                    const siguienteReferencia = siguienteFila.querySelector('[name="Referencias[]"]');
                    if (siguienteReferencia) { siguienteReferencia.focus(); siguienteReferencia.select(); }
                } else {
                    const cantidadActual = filaActual.querySelector('[name="Cantidades[]"]');
                    if (cantidadActual) cantidadActual.focus();
                }
            }
            /* ← AQUÍ: onblur también llena REG. INVIMA */
            function buscarProducto(input) {
                let ref = input.value, fila = input.closest('tr');
                if (!ref) return;
                fetch('?handler=BuscarProducto&referencia=' + encodeURIComponent(ref))
                    .then(res => res.json())
                    .then(data => {
                        if (data) {
                            const cod = fila.querySelector('[name="Codigos[]"]');
                            const desc = fila.querySelector('[name="Descripciones[]"]');
                            const inv = fila.querySelector('[name="Invimas[]"]');
                            if (cod) cod.value = (data.codigo || '').toUpperCase();
                            if (desc) desc.value = (data.descripcion || '').toUpperCase();
                            if (inv) inv.value = (data.regInvima || '').toUpperCase();
                        }
                    })
                    .catch(err => console.error('Error:', err));
            }

            document.querySelectorAll('input[type="text"]').forEach(input => {
                input.addEventListener('input', function() {
                    const start = this.selectionStart, end = this.selectionEnd;
                    this.value = this.value.toUpperCase();
                    this.setSelectionRange(start, end);
                });
                input.setAttribute('autocapitalize', 'characters');
                input.setAttribute('autocomplete', 'off');
                input.setAttribute('autocorrect', 'off');
                input.setAttribute('spellcheck', 'false');
            });
    </script>
</body>
</html>