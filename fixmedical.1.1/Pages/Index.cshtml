@page
@model fixmedical._1._1.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - FixMedical</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --bg-0: #05070f; --bg-1: #0a1226; --bg-2: #0d1b3a;
                --azul: #004b87; --azul-2: #002d54; --naranja: #f39200;
                --neon-cyan: #22d3ee; --txt: #eaf2ff; --txt-soft: #8fb3d9;
            }
            * { box-sizing: border-box; }
            html, body { height: 100%; }
            body {
                margin: 0; background-color: var(--bg-0); color: var(--txt);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow-x: hidden;
            }

            /* fondo en movimiento */
            .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
            .bg-gradient {
                position: absolute; inset: 0;
                background: linear-gradient(135deg, var(--bg-0) 0%, var(--bg-1) 45%, var(--bg-2) 100%);
                background-size: 200% 200%; animation: gradientShift 18s ease infinite;
            }
            .blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55; mix-blend-mode: screen; will-change: transform; }
            .b1 { width: 520px; height: 520px; background: radial-gradient(circle at 30% 30%, var(--naranja), transparent 60%); top: -120px; left: -100px; animation: float1 22s ease-in-out infinite; }
            .b2 { width: 620px; height: 620px; background: radial-gradient(circle at 70% 40%, var(--azul), transparent 60%); bottom: -180px; right: -140px; animation: float2 26s ease-in-out infinite; }
            .b3 { width: 420px; height: 420px; background: radial-gradient(circle at 50% 50%, var(--neon-cyan), transparent 60%); top: 38%; left: 55%; opacity: .30; animation: float3 30s ease-in-out infinite; }
            .grid-overlay {
                position: absolute; inset: 0;
                background-image: linear-gradient(rgba(34,211,238,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(34,211,238,.06) 1px, transparent 1px);
                background-size: 44px 44px;
                -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 0%, transparent 75%);
                mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 0%, transparent 75%);
            }
            #particles { position: fixed; inset: 0; z-index: 1; pointer-events: none; }

            .login-wrap { position: relative; z-index: 2; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
            .login-card {
                width: 100%; max-width: 420px; background: rgba(13,20,40,.60);
                -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%);
                border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 42px 38px;
                box-shadow: 0 20px 60px rgba(0,0,0,.55); position: relative; overflow: hidden;
                animation: cardIn .8s cubic-bezier(.2,.8,.2,1) both;
            }
                .login-card::before {
                    content: ""; position: absolute; top: 0; left: 12%; right: 12%; height: 2px;
                    background: linear-gradient(90deg, transparent, var(--naranja), var(--neon-cyan), transparent);
                    filter: blur(1px); opacity: .85;
                }

            .logo-wrap { display: flex; justify-content: center; margin-bottom: 26px; }
            .logo-img {
                max-width: 190px; height: auto; background: rgba(255,255,255,.95); padding: 12px 20px; border-radius: 14px;
                box-shadow: 0 0 26px rgba(243,146,0,.35), 0 8px 24px rgba(0,0,0,.35); animation: glowPulse 4s ease-in-out infinite;
            }

            /* 👇 CARTEL DE ERROR GRANDE: imposible de no ver (ya no es un "destello") */
            .login-errors {
                margin-bottom: 18px; padding: 14px 16px; border-radius: 12px;
                background: rgba(255,77,109,.14); border: 2px solid rgba(255,77,109,.6);
                color: #ffd2da; font-size: 14px; font-weight: 600;
                box-shadow: 0 0 22px rgba(255,77,109,.25);
            }
                .login-errors ul { margin: 0; padding-left: 20px; }
            .validation-summary-valid { display: none !important; }

            .login-success {
                margin-bottom: 18px; padding: 14px 16px; border-radius: 12px;
                background: rgba(52,211,153,.14); border: 2px solid rgba(52,211,153,.6);
                color: #6ee7b7; font-size: 14px; text-align: center; box-shadow: 0 0 22px rgba(52,211,153,.25);
            }

            .field { margin-bottom: 20px; }
            .field label {
                display: block; font-size: 12px; font-weight: 600; letter-spacing: .6px;
                text-transform: uppercase; color: var(--txt-soft); margin-bottom: 8px;
            }
            .neon-input {
                width: 100%; padding: 13px 15px; background: rgba(255,255,255,.04);
                border: 1px solid rgba(255,255,255,.12); border-radius: 10px; color: var(--txt);
                font-size: 15px; outline: none; transition: border-color .25s, box-shadow .25s, background .25s;
            }
                .neon-input::placeholder { color: rgba(234,242,255,.35); }
                .neon-input:focus {
                    border-color: var(--naranja); background: rgba(243,146,0,.06);
                    box-shadow: 0 0 0 3px rgba(243,146,0,.18), 0 0 18px rgba(243,146,0,.25);
                }

            .neon-btn {
                width: 100%; padding: 14px; border: 1px solid rgba(243,146,0,.35); border-radius: 10px;
                font-size: 15px; font-weight: 700; letter-spacing: .5px; color: #fff; cursor: pointer;
                background: linear-gradient(135deg, var(--azul) 0%, var(--azul-2) 100%);
                box-shadow: 0 8px 24px rgba(0,75,135,.45), 0 0 0 1px rgba(34,211,238,.12) inset;
                transition: transform .18s, box-shadow .25s, filter .25s; position: relative; overflow: hidden;
            }
                .neon-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(0,75,135,.6), 0 0 24px rgba(243,146,0,.5); filter: brightness(1.08); }
                .neon-btn:active { transform: translateY(0); }
                .neon-btn::after {
                    content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
                    background: linear-gradient(120deg, transparent, rgba(255,255,255,.28), transparent);
                    transform: skewX(-20deg); transition: left .6s;
                }
                .neon-btn:hover::after { left: 130%; }

            @@keyframes gradientShift { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
            @@keyframes float1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(60px,50px) scale(1.12)} }
            @@keyframes float2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-70px,-40px) scale(1.10)} }
            @@keyframes float3 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-50px,40px) scale(1.15)} }
            @@keyframes cardIn { from{opacity:0;transform:translateY(26px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
            @@keyframes glowPulse { 0%,100%{box-shadow:0 0 22px rgba(243,146,0,.30),0 8px 24px rgba(0,0,0,.35)} 50%{box-shadow:0 0 34px rgba(243,146,0,.55),0 8px 24px rgba(0,0,0,.35)} }

            @@media (prefers-reduced-motion: reduce) {
                .blob, .bg-gradient, .login-card, .logo-img { animation: none !important; }
                .neon-btn::after { display: none; }
            }
            @@media (max-width: 480px) { .login-card { padding: 32px 24px; } .logo-img { max-width: 160px; } }
    </style>
</head>
<body>

    <div class="bg" aria-hidden="true">
        <div class="bg-gradient"></div>
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="blob b3"></div>
        <div class="grid-overlay"></div>
    </div>
    <canvas id="particles" aria-hidden="true"></canvas>

    <main class="login-wrap">
        <div class="login-card">

            <div class="logo-wrap">
                <img src="/images/logo_fix.png" alt="Logo FixMedical" class="logo-img" />
            </div>

            <form method="post">

                <!-- 👇 Cartel de error GRANDE (si algo falla, lo ves sí o sí) -->
                <div asp-validation-summary="ModelOnly" class="login-errors"></div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="login-success" role="alert">
                        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <div class="field">
                    <label asp-for="Input.Email">Correo electrónico</label>
                    <input asp-for="Input.Email" class="neon-input" type="email" placeholder="nombre@correo.com"
                           autocomplete="username" required />
                </div>

                <div class="field">
                    <label asp-for="Input.Password">Contraseña</label>
                    <input asp-for="Input.Password" class="neon-input" type="password" placeholder="••••••••"
                           autocomplete="current-password" required />
                </div>

                <button type="submit" class="neon-btn">Iniciar Sesión</button>

            </form>

        </div>
    </main>

    <script>
        (function () {
            try {
                var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (reduce) return;
                var canvas = document.getElementById('particles');
                if (!canvas || !canvas.getContext) return;
                var ctx = canvas.getContext('2d');
                var w, h, particles = [];
                var COLORS = ['34,211,238', '243,146,0', '255,77,141'];
                function resize() {
                    w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight;
                    var count = Math.min(90, Math.floor((w * h) / 16000)); particles = [];
                    for (var i = 0; i < count; i++) {
                        particles.push({ x: Math.random()*w, y: Math.random()*h, vx:(Math.random()-0.5)*0.4, vy:(Math.random()-0.5)*0.4, r: Math.random()*1.8+0.6, c: COLORS[Math.floor(Math.random()*COLORS.length)] });
                    }
                }
                function draw() {
                    ctx.clearRect(0,0,w,h);
                    for (var i=0;i<particles.length;i++){
                        var p=particles[i]; p.x+=p.vx; p.y+=p.vy;
                        if(p.x<0||p.x>w)p.vx*=-1; if(p.y<0||p.y>h)p.vy*=-1;
                        ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fillStyle='rgba('+p.c+',0.8)'; ctx.fill();
                        for(var j=i+1;j<particles.length;j++){
                            var q=particles[j]; var dx=p.x-q.x, dy=p.y-q.y, dist=Math.sqrt(dx*dx+dy*dy);
                            if(dist<120){ ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(q.x,q.y); ctx.strokeStyle='rgba('+p.c+','+(0.12*(1-dist/120))+')'; ctx.lineWidth=0.6; ctx.stroke(); }
                        }
                    }
                    requestAnimationFrame(draw);
                }
                resize(); window.addEventListener('resize', resize); draw();
            } catch (e) { }
        })();
    </script>
</body>
</html>